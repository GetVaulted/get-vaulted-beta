generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BuyingFormat {
  buy_now
  auction
}

enum ListingStatus {
  draft
  active
  sold
  auction_live
  /// Auction time ended; winner must complete Stripe checkout before transfer.
  awaiting_auction_payment
  /// Winner did not pay within the payment window; listing is not sold.
  auction_ended_unpaid
  /// Reserved by an active marketplace layaway plan (deposit collected).
  layaway_reserved
  /// Seller-ended (or admin-approved early end); hidden from marketplace discovery.
  ended
}

enum ListingEndRequestStatus {
  pending
  approved
  denied
  canceled_by_seller
}

enum ListingEndReasonCategory {
  item_damaged
  listing_mistake
  inventory_unavailable
  suspected_fraud
  shipping_issue
  other
}

enum UserRole {
  user
  admin
}

enum LiveRoomType {
  auction
  sale
  break
}

enum LiveRoomStatus {
  scheduled
  live
  ended
}

enum LiveStreamProvider {
  none
  aws_ivs
}

/// How a room's video is delivered. `stage_webrtc` = IVS Real-Time (sub-second WebRTC);
/// `channel_hls` = IVS Low-Latency/HLS channel (OBS path + overflow/replay fallback).
enum LiveStreamMode {
  stage_webrtc
  channel_hls
}

enum LiveStreamHealth {
  not_provisioned
  offline
  connecting
  live
  ended
  error
}

enum LiveRoomItemStatus {
  queued
  active
  sold
  skipped
}

enum LiveItemSalesFormat {
  auction
  buy_now
  variant_selection
  team_break
}

enum LiveItemVariantStatus {
  available
  reserved
  sold_out
}

enum LiveItemVariantPurchaseStatus {
  pending_payment
  paid
  failed
  cancelled
}

enum LiveRoomPaymentFailureStatus {
  payment_failed
  recovery_pending
  paid
}

enum LiveRoomPaymentFailureKind {
  auction_win
  buy_now
  break_spot
  variant_purchase
}

enum LiveRoomMessageType {
  chat
  bid
  purchase
  system
  tip
}

enum TipRecipientMode {
  host
  moderator
}

enum LiveTipStatus {
  pending
  paid
  failed
}

enum BreakFormat {
  pick_your_team
  random_teams
  random_divisions
}

/// Host workflow for a break spot claim (distinct from queue item status).
enum BreakSpotClaimStatus {
  confirmed
  paid
  locked
  released
}

enum TeamBoardLeague {
  nfl
  nba
  mlb
}

/// How marketplace order payment is collected.
enum OrderPaymentMethod {
  stripe
  escrow
  layaway
}

/// Marketplace layaway plan length (buyer-selected at checkout).
enum LayawayPlanType {
  thirty_day
  sixty_day
}

/// Marketplace layaway lifecycle.
enum LayawayStatus {
  active
  paid_off
  defaulted
  refunded
  completed
}

/// Layaway payment kind for audit and Stripe reconciliation.
enum LayawayPaymentKind {
  deposit
  installment
  balance_payoff
}

/// High-value escrow lifecycle (provider-agnostic names).
enum EscrowStatus {
  pending
  buyer_paid
  seller_shipped
  delivered
  inspection_period
  approved
  funds_released
  disputed
  cancelled
}

/// Short-lived reservation to prevent cross-channel oversell (live, checkout, offers).
enum LiveAuctionInventoryHoldStatus {
  active
  consumed
  released
  expired
}

enum InstantPayoutStatus {
  eligible
  ineligible
  suspended
  admin_override
}

enum PayoutRiskLevel {
  low
  medium
  high
}

enum OrderPayoutStatus {
  pending
  held
  delivery_confirmed
  fast_payout_ready
  label_payout_ready
  instant_payout_ready
  paid_out
  blocked
  manual_review
}

enum OrderPayoutMethod {
  standard
  fast_after_acceptance
  instant_after_label
  instant_after_delivery
}

enum SellerPayoutTier {
  standard
  fast
  instant
}

enum PayoutTierApprovalStatus {
  not_eligible
  eligible
  pending_approval
  approved
  denied
  suspended
}

/// Instant payout admin review workflow (separate from fast-tier approval).
enum InstantPayoutApprovalStatus {
  not_eligible
  eligible
  under_review
  approved
  suspended
}

enum AccountStanding {
  excellent
  good
  needs_attention
  restricted
}

/// Public-facing seller trust level (branding only — not payout mechanics).
enum SellerLevel {
  vault_seller
  trusted_seller
  vault_verified
  elite_vault_verified
}

enum SellerFraudStatus {
  none
  flagged
  investigation
}

enum ReportTargetType {
  user
  listing
  live_room
  message
  order
  break
}

enum ReportReason {
  harassment
  counterfeit
  scam_fraud
  spam
  inappropriate_content
  fake_bids
  seller_misconduct
  buyer_misconduct
  ip_violation
  other
}

enum ReportStatus {
  open
  reviewing
  resolved
  dismissed
}

enum LiveRoomModerationActionType {
  mute
  unmute
  delete_message
  kick
  room_ban
  unban
  block_bidding
  unblock_bidding
  slow_mode
  pin_message
}

enum DisputeEvidenceStatus {
  pending
  ready
  failed
}

enum ShippingCategory {
  raw_card
  slab
  small_collectible
  custom
}

/// Which Shippo quotes buyers may choose at marketplace checkout.
enum MarketplaceShippingOfferScope {
  all
  no_overnight
  custom
}

enum AddressType {
  shipping
  return
  billing
  ship_from
}

enum TradeOfferStatus {
  pending
  countered
  accepted
  completed
  declined
  cancelled
  expired
}

enum TradeItemSide {
  proposer
  recipient
}

enum TradeOfferEventType {
  offer_created
  offer_countered
  offer_accepted
  offer_declined
  offer_cancelled
  offer_expired
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String    @unique
  passwordHash  String?
  name          String?
  image         String?
  emailVerified DateTime?
  role          UserRole  @default(user)
  suspendedAt   DateTime?
  /// Stripe Connect Express / Standard connected account id (`acct_...`).
  stripeAccountId           String?
  /// True when Stripe reports charges enabled and payouts ready for selling.
  stripeOnboardingComplete  Boolean   @default(false)
  /// Mirrors Stripe Account.charges_enabled (Connect).
  stripeChargesEnabled      Boolean?
  /// Mirrors Stripe Account.payouts_enabled (Connect).
  stripePayoutsEnabled      Boolean?
  /// Snapshot of requirement fields (currently_due, pending_verification, etc.) for dashboards + mobile.
  stripeRequirementsDue     Json?
  /// e.g. individual.verification.status from Stripe when present.
  stripeVerificationStatus  String?
  /// Stripe Customer id (`cus_...`) for buyer saved payment methods (auction / checkout).
  stripeCustomerId          String?
  /// Seller ship-from (origin) for Shippo label purchase.
  shipFromName    String?
  shipFromStreet  String?
  shipFromCity    String?
  shipFromState   String?
  shipFromZip     String?
  shipFromCountry String?
  /// Set when seller finishes the onboarding wizard (step 5); syncs web + mobile activation.
  sellerSetupWizardCompletedAt DateTime?
  /// Seller accepted marketplace seller agreement (Terms §5).
  sellerAgreementAcceptedAt   DateTime?
  /// Soft-delete — account anonymized; financial records retained.
  accountDeletedAt            DateTime?
  defaultShipFromAddressId String?
  defaultShipFromAddress   Address? @relation("UserDefaultShipFromAddress", fields: [defaultShipFromAddressId], references: [id], onDelete: SetNull)
  /// Trustap external user id (`1-…`) when this user participates in escrow as seller (or linked buyer).
  trustapUserId String?
  /// Cached result of seller instant-payout eligibility checks (admin may override).
  instantPayoutEligible        Boolean             @default(false)
  instantPayoutStatus          InstantPayoutStatus @default(ineligible)
  instantPayoutOverrideByAdmin Boolean             @default(false)
  instantPayoutOverrideReason  String?
  instantPayoutOverrideAdminId String?
  instantPayoutOverrideAt      DateTime?
  payoutRiskLevel              PayoutRiskLevel     @default(medium)
  /// Standard payout hold length (days) when instant payout is not available.
  payoutHoldDays               Int                 @default(7)
  /// Percent of order GMV held in reserve (0–100).
  payoutReservePercent         Float               @default(0)
  /// Cached seller payout program tier (standard / fast / instant).
  payoutTier                   SellerPayoutTier           @default(standard)
  fastPayoutStatus             PayoutTierApprovalStatus   @default(not_eligible)
  fastPayoutOverrideByAdmin    Boolean                    @default(false)
  fastPayoutOverrideReason     String?
  fastPayoutOverrideAdminId    String?
  fastPayoutOverrideAt         DateTime?
  instantPayoutApprovalStatus  InstantPayoutApprovalStatus @default(not_eligible)
  instantPayoutReviewDate      DateTime?
  instantPayoutReviewedById    String?
  instantPayoutReviewNotes     String?
  instantPayoutRejectionReason String?
  /// Public seller level badge (Vault Seller → Elite Vault Verified).
  sellerLevel                  SellerLevel                @default(vault_seller)
  sellerLevelOverrideByAdmin   Boolean                    @default(false)
  sellerLevelOverrideAdminId   String?
  sellerLevelOverrideAt        DateTime?
  /// Per-seller instant payout limit overrides (USD); null = platform default.
  instantPayoutPerOrderLimitUsd  Float?
  instantPayoutDailyLimitUsd   Float?
  instantPayoutExposureLimitUsd Float?
  payoutTierSuspensionReason   String?
  payoutTierSuspendedAt        DateTime?
  payoutMetrics                SellerPayoutMetrics?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  listings           Listing[]           @relation("SellerListings")
  listingEndRequests ListingEndRequest[] @relation("ListingEndRequestSeller")
  listingEndReviews  ListingEndRequest[] @relation("ListingEndRequestReviewer")
  bids          Bid[]
  offers        Offer[]         @relation("OfferBuyer")
  sellerOffers  Offer[]       @relation("OfferSeller")
  orders        Order[]         @relation("OrderBuyer")
  sales         Order[]         @relation("OrderSeller")
  watchlist       WatchlistItem[]
  messagesSent    Message[]       @relation("MsgSender")
  messagesRecv    Message[]       @relation("MsgRecipient")
  threadsAsBuyer  MessageThread[] @relation("ThreadBuyer")
  threadsAsSeller MessageThread[] @relation("ThreadSeller")
  messageThreadParticipants MessageThreadParticipant[]
  notifications   Notification[]
  pushDeviceTokens PushDeviceToken[]
  liveRooms       LiveRoom[]
  liveRoomMessages LiveRoomMessage[]
  breakSpots      BreakSpot[]
  liveItemVariantPurchases LiveItemVariantPurchase[]
  liveRoomPaymentFailures LiveRoomPaymentFailure[]
  breakHitsBuyer  BreakHit[] @relation("BreakHitBuyer")
  hitClipsAsSeller HitClip[] @relation("HitClipSeller")
  hitClipsAsBuyer  HitClip[] @relation("HitClipBuyer")
  sellerFollowsAsFollower SellerFollow[] @relation("SellerFollowFollower")
  sellerFollowsAsSeller   SellerFollow[] @relation("SellerFollowSeller")
  teamBoardPicks          LiveRoomTeamBoardPick[]
  teamBoardAsPicker       LiveRoomTeamBoard[]     @relation("LiveRoomTeamBoardPicker")
  sellerCommerceEvents    SellerCommerceEvent[]   @relation("SellerCommerceEvents")
  liveShippingSessionsAsBuyer LiveShippingSession[] @relation("LiveShippingSessionsBuyer")
  liveShippingSessionsAsSeller LiveShippingSession[] @relation("LiveShippingSessionsSeller")
  addresses     Address[] @relation("UserAddresses")
  tradeOffersSent     TradeOffer[]     @relation("TradeOfferProposer")
  tradeOffersReceived TradeOffer[]     @relation("TradeOfferRecipient")
  tradeOfferItems     TradeOfferItem[] @relation("TradeOfferItemOwner")
  tradeOfferEvents    TradeOfferEvent[] @relation("TradeOfferEventActor")
  emailVerificationCodes EmailVerificationCode[]
  liveAuctionProxyBids LiveAuctionProxyBid[]
  liveAuctionInventoryHolds LiveAuctionInventoryHold[]
  liveRoomBids              LiveRoomBid[]
  liveRoomsAsTipModerator LiveRoom[] @relation("LiveRoomTipModerator")
  liveTipsSent     LiveTip[] @relation("LiveTipSender")
  liveTipsReceived LiveTip[] @relation("LiveTipRecipient")
  payoutEligibilityAuditLogsAsSeller PayoutEligibilityAuditLog[] @relation("PayoutAuditSeller")
  payoutEligibilityAuditLogsAsAdmin  PayoutEligibilityAuditLog[] @relation("PayoutAuditAdmin")
  reportsFiled                       Report[]                    @relation("ReportReporter")
  reportsAssigned                    Report[]                    @relation("ReportAssignee")
  liveRoomModeratorAssignments       LiveRoomModerator[]         @relation("LiveRoomModeratorUser")
  liveRoomModeratorAssignedBy        LiveRoomModerator[]         @relation("LiveRoomModeratorAssignedBy")
  liveRoomModerationActionsTaken     LiveRoomModerationAction[]  @relation("LiveRoomModerationActor")
  liveRoomModerationActionsReceived  LiveRoomModerationAction[]  @relation("LiveRoomModerationTarget")
  reportAuditLogs                    ReportAuditLog[]
  trustModerationAuditLogs           TrustModerationAuditLog[]
  liveStreamReplaysAsSeller          LiveStreamReplay[]          @relation("LiveStreamReplaySeller")
  disputeEvidenceGenerated           DisputeEvidenceBundle[]     @relation("DisputeEvidenceAdmin")
  liveRoomMessagesDeleted            LiveRoomMessage[]           @relation("LiveRoomMessageDeletedBy")
  layawaysAsBuyer                    Layaway[]                   @relation("LayawayBuyer")
  layawaysAsSeller                   Layaway[]                   @relation("LayawaySeller")
}

/// Single-use email verification OTP for signup (hashed at rest; expires).
model EmailVerificationCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([userId, consumedAt])
}

model Address {
  id        String      @id @default(cuid())
  userId    String
  user      User        @relation("UserAddresses", fields: [userId], references: [id], onDelete: Cascade)
  type      AddressType
  name      String
  fullName  String
  company   String?
  line1     String
  line2     String?
  city      String
  state     String
  postalCode String
  country   String      @default("US")
  phone     String?
  email     String?
  isDefault Boolean     @default(false)
  isVerified Boolean    @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  defaultForUsers User[] @relation("UserDefaultShipFromAddress")
  listings       Listing[] @relation("ListingShipFromAddress")
  buyerOrders    Order[]   @relation("OrderBuyerAddress")
  sellerOrders   Order[]   @relation("OrderSellerShipFromAddress")

  @@index([userId, type, isDefault])
}

/// Seller-visible timeline (auction recovery, payment expiry, etc.).
model SellerCommerceEvent {
  id        String   @id @default(cuid())
  sellerId  String
  seller    User     @relation("SellerCommerceEvents", fields: [sellerId], references: [id], onDelete: Cascade)
  listingId String?
  orderId   String?
  kind      String
  title     String
  body      String
  createdAt DateTime @default(now())

  @@index([sellerId, createdAt])
  @@index([listingId])
}

model SellerFollow {
  id          String   @id @default(cuid())
  followerId  String
  sellerId    String
  follower    User     @relation("SellerFollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  seller      User     @relation("SellerFollowSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([followerId, sellerId])
  @@index([sellerId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  href      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model PushDeviceToken {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expoPushToken      String
  platform           String?
  deviceName         String?
  supabaseAuthUserId String?
  updatedAt          DateTime @updatedAt

  @@unique([userId, expoPushToken])
  @@index([userId])
  @@index([supabaseAuthUserId])
}

model Listing {
  id                  String         @id @default(cuid())
  sellerId            String
  seller              User           @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Cascade)
  title               String
  description         String         @default("")
  category            String
  condition           String
  buyingFormat        BuyingFormat
  priceUsd            Float
  startingBidUsd      Float?
  currentBidUsd       Float?
  allowOffers         Boolean        @default(false)
  /// Marketplace layaway (V1): seller opt-in for listings priced at $500+.
  allowLayaway        Boolean        @default(false)
  acceptTradeOffers   Boolean        @default(false)
  minimumOfferUsd     Float?
  status              ListingStatus  @default(draft)
  shippingPriceUsd    Float          @default(0)
  handlingTime        String         @default("")
  signatureRequired   Boolean        @default(false)
  reservePriceUsd     Float?
  auctionDurationDays Int?
  auctionEndsAt       DateTime?
  viewsCount          Int            @default(0)
  watchersCount       Int            @default(0)
  vaultPick           Boolean        @default(false)
  /// Official company / merch listing — no marketplace platform fee on checkout (admin-only flag).
  isCompanyListing    Boolean        @default(false)
  /// Hidden from marketplace when set (admin moderation)
  moderationRemovedAt DateTime?
  adminReviewedAt     DateTime?
  /// Single autosave slot per seller (Create Listing draft)
  workspaceKey        String?
  /// Parcel dimensions/weight for Shippo (imperial). Optional until seller fills for physical checkout.
  parcelWeightOz   Float?
  parcelLengthIn   Float?
  parcelWidthIn    Float?
  parcelHeightIn   Float?
  /// Buyer-facing live shipping profile (separate from Shippo parcel/label weight).
  shippingCategory            ShippingCategory @default(raw_card)
  shippingBaseWeightOz        Float            @default(4)
  shippingIncrementalWeightOz Float            @default(1)
  shippingPriceCapCents       Int?
  shipAlone                   Boolean          @default(false)
  shipFromAddressId      String?
  shipFromAddress        Address?       @relation("ListingShipFromAddress", fields: [shipFromAddressId], references: [id], onDelete: SetNull)
  /// Seller rules for buyer-facing Shippo rate options at checkout.
  marketplaceShippingOfferScope MarketplaceShippingOfferScope @default(all)
  marketplaceAllowedRateKeys      String[]                      @default([])
  /// Canonical carrier keys (usps, ups, fedex, …) the seller offers at checkout.
  marketplaceAllowedCarriers      String[]                      @default([])
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  images    ListingImage[]
  offers    Offer[]
  bids      Bid[]
  orders    Order[]
  watchlist      WatchlistItem[]
  messages       Message[]
  messageThreads MessageThread[]
  liveRoomItems  LiveRoomItem[]
  liveShippingSessionItems LiveShippingSessionItem[]
  incomingTradeOffers TradeOffer[]     @relation("TradeOfferTargetListing")
  tradeOfferItems     TradeOfferItem[] @relation("TradeOfferItemListing")
  inventoryHolds      LiveAuctionInventoryHold[]
  endRequests         ListingEndRequest[]
  endAuditLogs        ListingEndAuditLog[]
  layaway             Layaway?

  @@unique([sellerId, workspaceKey])
}

model ListingEndRequest {
  id             String                   @id @default(cuid())
  listingId      String
  listing        Listing                  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sellerId       String
  seller         User                     @relation("ListingEndRequestSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  status         ListingEndRequestStatus  @default(pending)
  reasonCategory ListingEndReasonCategory
  reasonText     String
  adminNote      String?
  createdAt      DateTime                 @default(now())
  reviewedAt     DateTime?
  reviewedById   String?
  reviewedBy     User?                    @relation("ListingEndRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  auditLogs      ListingEndAuditLog[]

  @@index([listingId, status, createdAt])
  @@index([sellerId, createdAt])
}

model ListingEndAuditLog {
  id                  String             @id @default(cuid())
  listingId           String
  listing             Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingEndRequestId String?
  listingEndRequest   ListingEndRequest? @relation(fields: [listingEndRequestId], references: [id], onDelete: SetNull)
  actorUserId         String?
  action              String
  detail              String             @default("")
  createdAt           DateTime           @default(now())

  @@index([listingId, createdAt])
}

model TradeOffer {
  id String @id @default(cuid())
  targetListingId String
  targetListing   Listing @relation("TradeOfferTargetListing", fields: [targetListingId], references: [id], onDelete: Cascade)
  proposerId String
  proposer   User   @relation("TradeOfferProposer", fields: [proposerId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User   @relation("TradeOfferRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  status TradeOfferStatus @default(pending)
  proposerCashUsd Float @default(0)
  recipientCashUsd Float @default(0)
  messageToRecipient String?
  // Future hook only: optional trade-linked conversation id.
  // MVP keeps chat disabled; structured offer state + timeline are authoritative.
  // Any future messaging must remain participant-scoped from the trade detail page.
  conversationId String?
  expiresAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items  TradeOfferItem[]
  events TradeOfferEvent[]

  @@index([targetListingId, status, createdAt])
  @@index([proposerId, status, createdAt])
  @@index([recipientId, status, createdAt])
  @@index([status, updatedAt])
  @@index([conversationId])
  @@index([expiresAt])
}

model TradeOfferItem {
  id String @id @default(cuid())
  tradeOfferId String
  tradeOffer   TradeOffer @relation(fields: [tradeOfferId], references: [id], onDelete: Cascade)
  side TradeItemSide
  ownerUserId String
  ownerUser   User @relation("TradeOfferItemOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing @relation("TradeOfferItemListing", fields: [listingId], references: [id], onDelete: Restrict)
  quantity Int @default(1)
  // Snapshot fields preserve offer integrity if source listing changes.
  listingTitleSnapshot String
  listingImageUrlSnapshot String?
  listingCategorySnapshot String
  listingConditionSnapshot String
  listingPriceUsdSnapshot Float
  createdAt DateTime @default(now())

  @@index([tradeOfferId, side])
  @@index([ownerUserId, createdAt])
  @@index([listingId])
  @@unique([tradeOfferId, side, listingId])
}

model TradeOfferEvent {
  id String @id @default(cuid())
  tradeOfferId String
  tradeOffer   TradeOffer @relation(fields: [tradeOfferId], references: [id], onDelete: Cascade)
  type TradeOfferEventType
  actorUserId String?
  actorUser   User? @relation("TradeOfferEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  note String?
  createdAt DateTime @default(now())

  @@index([tradeOfferId, createdAt])
  @@index([actorUserId, createdAt])
}

model LiveRoom {
  id                 String         @id @default(cuid())
  sellerId           String
  seller             User           @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title              String
  description        String         @default("")
  /// Browse / filter bucket (matches live directory chips)
  category           String         @default("Other")
  roomType           LiveRoomType
  status             LiveRoomStatus @default(scheduled)
  thumbnailUrl       String         @default("")
  viewerCount        Int            @default(0)
  streamProvider     LiveStreamProvider @default(none)
  streamMode         LiveStreamMode     @default(stage_webrtc)
  streamHealth       LiveStreamHealth   @default(not_provisioned)
  ivsChannelArn      String?
  ivsChannelName     String?
  ivsPlaybackUrl     String?
  ivsIngestEndpoint  String?
  /// IVS Real-Time Stage ARN (WebRTC publish/subscribe). Null until a browser/mobile Go Live provisions it.
  ivsStageArn        String?
  /// Active stage->channel composition ARN (HLS mirror for fallback/overflow/replay). Null when not compositing.
  ivsCompositionArn  String?
  ivsStreamKeyArn    String?
  ivsStreamKeyCreatedAt DateTime?
  streamStartedAt    DateTime?
  streamEndedAt      DateTime?
  lastIvsStatusSyncAt DateTime?
  lastIvsError       String?
  /// SHA-256 hash of OBS browser-source widget token (plain token shown once on rotate).
  obsWidgetTokenHash String?
  obsWidgetTokenRotatedAt DateTime?
  scheduledStartAt   DateTime?
  startedAt          DateTime?
  endedAt            DateTime?
  /// Monotonic room-state version for realtime ordering/reconciliation.
  roomVersion        Int            @default(0)
  /// Monotonic per-room auction event sequence (`LiveAuctionEvent.seq`); canonical ordering for fan-out.
  auctionEventSeq    Int            @default(0)
  /// Cumulative completed item-sale GMV (USD) for this show session; resets when the show ends.
  completedSalesGmvUsd Float        @default(0)
  /// Who receives tips during this show (`moderator` requires `tipModeratorId`).
  tipRecipientMode   TipRecipientMode @default(host)
  tipModeratorId     String?
  tipModerator       User?            @relation("LiveRoomTipModerator", fields: [tipModeratorId], references: [id], onDelete: SetNull)
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  /// Break host console — setup & randomization (break rooms only).
  breakFormat               BreakFormat @default(pick_your_team)
  /// When set, shown in host console / feed; falls back to `title` if empty.
  breakDisplayTitle         String      @default("")
  breakSpotPriceUsd         Float?
  breakTotalSpots           Int?
  /// JSON string[] team / spot labels for random modes.
  breakTeamLabelsJson       String      @default("[]")
  breakFilledLockedAt       DateTime?
  assignmentsLockedAt     DateTime?
  randomizedAt            DateTime?
  randomizationSeed       String?
  randomizationPreviewJson String?
  randomizationResultJson String?
  lockPurchases           Boolean     @default(false)
  breakPaused             Boolean     @default(false)
  /// PYT team board organization (break rooms). Set at room creation.
  teamBoardLeague         TeamBoardLeague @default(nba)

  items      LiveRoomItem[]
  messages   LiveRoomMessage[]
  breakSpots BreakSpot[]
  variantPurchases LiveItemVariantPurchase[]
  breakHits  BreakHit[]
  hitClips   HitClip[]
  teamBoard  LiveRoomTeamBoard?
  shippingSessions LiveShippingSession[]
  auctionEvents LiveAuctionEvent[]
  proxyBids LiveAuctionProxyBid[]
  roomBids LiveRoomBid[]
  tips      LiveTip[]
  moderators LiveRoomModerator[]
  moderationActions LiveRoomModerationAction[]
  streamReplays LiveStreamReplay[]
  paymentFailures LiveRoomPaymentFailure[]
  reports Report[]
  slowModeSeconds Int @default(0)
  pinnedModeratorMessage String?
  pinnedModeratorMessageAt DateTime?

  @@index([sellerId, status])
  @@index([status, scheduledStartAt])
  @@index([tipModeratorId])
}

/// Viewer tip during a live show — tracked separately from item/break sales (no platform fee, no GMV tier impact).
model LiveTip {
  id                      String         @id @default(cuid())
  liveRoomId              String
  liveRoom                LiveRoom       @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  senderId                String
  sender                  User           @relation("LiveTipSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId             String
  recipient               User           @relation("LiveTipRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  amountUsd               Float
  message                 String         @default("")
  status                  LiveTipStatus  @default(pending)
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paidAt                  DateTime?
  createdAt               DateTime       @default(now())
  updatedAt               DateTime       @updatedAt

  @@index([liveRoomId, createdAt])
  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
}

/// Durable canonical auction fan-out stream (per room). `seq` is monotonic per `liveRoomId`.
/// `publishedAt` null = pending flush to realtime gateways.
model LiveAuctionEvent {
  id          String    @id @default(cuid())
  liveRoomId  String
  liveRoom    LiveRoom  @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  seq         Int
  eventType   String
  itemId      String?
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([liveRoomId, seq])
  @@index([liveRoomId, publishedAt, seq])
}

/// Idempotent bid POST responses (`Idempotency-Key` header).
model LiveBidIdempotency {
  id         String   @id @default(cuid())
  userId     String
  liveRoomId String
  itemId     String
  key        String
  statusCode Int
  body       Json
  createdAt  DateTime @default(now())

  @@unique([userId, liveRoomId, itemId, key])
  @@index([createdAt])
}

/// Cross-channel inventory reservation (listing = single sellable unit in current schema).
/// Partial unique indexes (Postgres) enforce at most one `active` hold per `listingId` / host `liveRoomItemId` — see migration SQL.
model LiveAuctionInventoryHold {
  id             String                         @id @default(cuid())
  listingId      String?
  listing        Listing?                       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  liveRoomItemId String?
  liveRoomItem   LiveRoomItem?                  @relation(fields: [liveRoomItemId], references: [id], onDelete: Cascade)
  userId         String
  user           User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         LiveAuctionInventoryHoldStatus @default(active)
  /// e.g. `buy_now_checkout`, `auction_win_order`, `offer_accept`
  source         String
  units          Int                            @default(1)
  idempotencyKey String?
  expiresAt      DateTime
  consumedAt     DateTime?
  releasedAt     DateTime?
  orderId        String?
  order          Order?                         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt

  @@index([listingId, status])
  @@index([liveRoomItemId, status])
  @@index([status, expiresAt])
  @@index([userId, listingId, status])
}

/// Buyer max (proxy) bid ceiling for live-room items without marketplace listing sync (host lots).
/// Listing-backed lots use marketplace `Bid` / `placeListingBid` only — proxy rows are ignored there.
model LiveAuctionProxyBid {
  id             String       @id @default(cuid())
  liveRoomId     String
  liveRoom       LiveRoom     @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  liveRoomItemId String
  liveRoomItem   LiveRoomItem @relation(fields: [liveRoomItemId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  maxAmountUsd   Float
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([liveRoomItemId, userId])
  @@index([liveRoomItemId])
}

/// On-stream PYT team selection board (break rooms). One row per room.
model LiveRoomTeamBoard {
  liveRoomId          String          @id
  liveRoom            LiveRoom        @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  league              TeamBoardLeague @default(nba)
  visible             Boolean         @default(false)
  locked              Boolean         @default(false)
  currentPickerUserId String?
  currentPicker       User?           @relation("LiveRoomTeamBoardPicker", fields: [currentPickerUserId], references: [id], onDelete: SetNull)
  updatedAt           DateTime        @updatedAt

  picks LiveRoomTeamBoardPick[]
}

model LiveRoomTeamBoardPick {
  id         String          @id @default(cuid())
  liveRoomId String
  league     TeamBoardLeague
  teamAbbr   String
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  pickedAt   DateTime        @default(now())
  board      LiveRoomTeamBoard @relation(fields: [liveRoomId], references: [liveRoomId], onDelete: Cascade)

  @@unique([liveRoomId, league, teamAbbr])
  @@index([liveRoomId, league])
}

model LiveRoomItem {
  id             String             @id @default(cuid())
  liveRoomId     String
  liveRoom       LiveRoom           @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  listingId      String?
  listing        Listing?           @relation(fields: [listingId], references: [id], onDelete: SetNull)
  /// When the item has no `listingId`, host-settled auctions still need a winner id (see live bid route).
  lastHighBidderId String?
  title          String
  /// Remaining units on this queue row (decrements as each numbered unit sells).
  quantity       Int                @default(1)
  /// Original unit count when the row was created (never decrements).
  quantityInitial Int               @default(1)
  imageUrl       String             @default("")
  priceUsd       Float?
  startingBidUsd Float?
  /// Minimum raise per bid when set; otherwise server default increment curve applies.
  bidIncrementUsd Float?
  /// Optional reserve (hidden minimum to sell).
  reservePriceUsd Float?
  currentBidUsd  Float?
  status         LiveRoomItemStatus @default(queued)
  sortOrder      Int                @default(0)
  /// NFL break: when true, MISC appears on the team board while this item is active.
  teamBoardMisc  Boolean            @default(false)
  /// Monotonic item-state version for realtime ordering/reconciliation.
  itemVersion    Int                @default(0)
  /// When the lot is `active`, host must set this true (via Start) before buyers can bid / claim for timed window.
  biddingOpen    Boolean            @default(false)
  /// When set and in the future, bidding is allowed until this instant (set together with `biddingOpen`).
  auctionEndsAt  DateTime?
  /// Clutch Time ON = no bid-time extension; OFF = bids refresh time-to-expiry to 10s.
  clutchTimeEnabled Boolean        @default(false)
  /// Commerce format for this queue row (variant / team break = selectable options).
  salesFormat    LiveItemSalesFormat @default(auction)
  /// All variant spots sold — host can begin the break (team_break / PYD).
  variantBreakReadyAt DateTime?
  /// Host clicked Begin Break — broadcast to all viewers.
  variantBreakBeganAt DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  breakHits      BreakHit[]
  variants       LiveItemVariant[]

  proxyBids         LiveAuctionProxyBid[]
  inventoryHolds    LiveAuctionInventoryHold[]
  roomBids          LiveRoomBid[]

  @@index([liveRoomId, sortOrder])
}

/// Selectable option / spot on a master live queue item (PYT divisions, teams, custom).
model LiveItemVariant {
  id                String               @id @default(cuid())
  liveRoomItemId    String
  liveRoomItem      LiveRoomItem         @relation(fields: [liveRoomItemId], references: [id], onDelete: Cascade)
  label             String
  priceUsd          Float
  quantityInitial   Int                  @default(1)
  quantityRemaining Int                  @default(1)
  soldCount         Int                  @default(0)
  isHot             Boolean              @default(false)
  imageUrl          String               @default("")
  color             String               @default("")
  sortOrder         Int                  @default(0)
  status            LiveItemVariantStatus @default(available)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  purchases         LiveItemVariantPurchase[]

  @@unique([liveRoomItemId, label])
  @@index([liveRoomItemId, sortOrder])
}

/// Per-buyer purchase of a variant option — one record per claim (never overwrite winners).
model LiveItemVariantPurchase {
  id                      String                        @id @default(cuid())
  liveRoomId              String
  liveRoom                LiveRoom                      @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  liveRoomItemId          String
  variantId               String
  variant                 LiveItemVariant               @relation(fields: [variantId], references: [id], onDelete: Cascade)
  buyerId                 String
  buyer                   User                          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  quantity                Int                           @default(1)
  unitPriceUsd            Float
  totalUsd                Float
  paymentStatus           LiveItemVariantPurchaseStatus @default(pending_payment)
  idempotencyKey          String?                       @unique
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paidAt                  DateTime?
  createdAt               DateTime                      @default(now())

  @@index([variantId, paymentStatus])
  @@index([liveRoomId, createdAt])
  @@index([buyerId, createdAt])
}

/// Unresolved live-show payment failure — blocks buyer commerce in-room until paid or cleared.
model LiveRoomPaymentFailure {
  id                String                       @id @default(cuid())
  liveRoomId        String
  liveRoom          LiveRoom                     @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  buyerId           String
  buyer             User                         @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  kind              LiveRoomPaymentFailureKind
  liveRoomItemId    String?
  orderId           String?
  variantPurchaseId String?
  breakSpotId       String?
  amountUsd         Float
  status            LiveRoomPaymentFailureStatus @default(payment_failed)
  failureReason     String?
  buyerUsername     String?
  itemTitle         String?
  failedAt          DateTime                     @default(now())
  recoveredAt       DateTime?
  updatedAt         DateTime                     @updatedAt

  @@index([liveRoomId, buyerId, status])
  @@index([liveRoomId, status])
  @@index([buyerId, status])
}

/// Accepted bid on a host lot (`listingId` null). Listing-backed lots use marketplace `Bid` rows.
model LiveRoomBid {
  id              String       @id @default(cuid())
  liveRoomId      String
  liveRoom        LiveRoom     @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  liveRoomItemId  String
  liveRoomItem    LiveRoomItem @relation(fields: [liveRoomItemId], references: [id], onDelete: Cascade)
  bidderId        String
  bidder          User         @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  amountUsd       Float
  auctionEventSeq Int
  idempotencyKey  String?
  /// Postgres transaction `now()` when the bid was accepted.
  acceptedAt      DateTime
  createdAt       DateTime     @default(now())

  @@index([liveRoomItemId, acceptedAt])
  @@index([liveRoomId, acceptedAt])
  @@index([bidderId, acceptedAt])
}

/// PYT / break spot claims (placeholder commerce — no Order row).
model BreakSpot {
  id             String               @id @default(cuid())
  liveRoomId     String
  liveRoom       LiveRoom             @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  spotLabel      String
  priceUsd       Float
  /// Legacy string kept for migration; prefer `claimStatus`.
  status         String               @default("confirmed")
  claimStatus    BreakSpotClaimStatus @default(confirmed)
  liveRoomItemId String?
  paidAt         DateTime?
  lockedAt       DateTime?
  /// Stripe Checkout for this spot (no Order row; digital claim).
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  breakPaymentStatus      String       @default("unpaid")
  createdAt      DateTime             @default(now())

  @@unique([liveRoomId, spotLabel])
  @@index([liveRoomId])
  @@index([userId])
}

/// Logged hits for host console / future clip pipeline.
model BreakHit {
  id             String        @id @default(cuid())
  liveRoomId     String
  liveRoom       LiveRoom      @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  liveRoomItemId String?
  liveRoomItem   LiveRoomItem? @relation(fields: [liveRoomItemId], references: [id], onDelete: SetNull)
  spotLabel      String        @default("")
  buyerId        String?
  buyer          User?         @relation("BreakHitBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  title          String
  notes          String        @default("")
  imageUrl       String        @default("")
  createdAt      DateTime      @default(now())

  hitClip HitClip?

  @@index([liveRoomId, createdAt])
}

/// Shareable highlight from a break hit (metadata now; optional `clipUrl` for future video).
model HitClip {
  id                String    @id @default(cuid())
  liveRoomId        String
  liveRoom          LiveRoom   @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  breakHitId        String?    @unique
  breakHit          BreakHit?  @relation(fields: [breakHitId], references: [id], onDelete: SetNull)
  sellerId          String
  seller            User       @relation("HitClipSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyerId           String?
  buyer             User?      @relation("HitClipBuyer", fields: [buyerId], references: [id], onDelete: SetNull)
  title             String
  description       String     @default("")
  thumbnailUrl      String     @default("")
  clipUrl           String?
  itemTitle         String?
  teamOrSpotLabel   String?
  shareCount        Int        @default(0)
  createdAt         DateTime   @default(now())

  @@index([liveRoomId, createdAt])
  @@index([sellerId, createdAt])
}

model LiveRoomMessage {
  id          String              @id @default(cuid())
  liveRoomId  String
  liveRoom    LiveRoom            @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body        String
  messageType LiveRoomMessageType @default(chat)
  deletedAt   DateTime?
  deletedByUserId String?
  deletedBy   User?               @relation("LiveRoomMessageDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime            @default(now())

  @@index([liveRoomId, createdAt])
}

model ListingImage {
  id        String   @id @default(cuid())
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int      @default(0)
}

model Offer {
  id               String   @id @default(cuid())
  listingId        String
  listing          Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sellerId         String
  seller           User     @relation("OfferSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyerId          String
  buyer            User     @relation("OfferBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  amountUsd        Float
  message          String?
  status           String   @default("pending")
  counterAmountUsd Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Bid {
  id         String   @id @default(cuid())
  listingId  String
  listing    Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidderId   String
  bidder     User     @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  /// Public price on the listing after this bid event (proxy-visible amount).
  amountUsd  Float
  /// Bidder’s maximum (proxy); never exposed to other users via listing APIs.
  maxBidUsd  Float?
  /// Confirmed ship-to when bid was placed (marketplace); used if this bidder wins.
  shipRecipientName String?
  shipAddress         String?
  shipCity            String?
  shipState           String?
  shipZip             String?
  shipCountry         String?
  /// Payment method label to charge when the bidder wins (e.g. placeholder until PSP is wired).
  paymentLabel        String?
  createdAt  DateTime @default(now())
}

model Order {
  id        String   @id @default(cuid())
  listingId String   @unique
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyerId   String
  buyer     User     @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId  String
  seller    User     @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  itemPriceUsd      Float
  shippingPriceUsd  Float    @default(0)
  /// Tax / fees placeholder (USD); buyer-paid sales tax synced from Stripe Tax.
  taxUsd            Float    @default(0)
  /// Buyer-paid sales tax in cents (Stripe Tax); excluded from seller payout and platform fee base.
  taxAmountCents    Int      @default(0)
  taxProvider       String?
  stripeTaxCalculationId String?
  totalUsd          Float
  /// Legacy lifecycle: pending → paid → shipped (mirrors fulfillment where applicable).
  status            String   @default("pending")
  /// Stripe payment lifecycle; webhooks are source of truth.
  paymentStatus     String   @default("paid")
  /// Shipment / label lifecycle.
  fulfillmentStatus String   @default("pending")
  shipRecipientName String
  shipAddress       String
  shipCity          String
  shipState         String
  shipZip           String
  shipCountry       String
  paymentLabel      String   @default("placeholder")
  /// Marketplace: Stripe Checkout vs third-party escrow (e.g. Trustap).
  paymentMethod           OrderPaymentMethod @default(stripe)
  /// Escrow integration id (e.g. Trustap transaction id). Null when `paymentMethod` is stripe.
  escrowProvider          String?
  escrowTransactionId     String?
  escrowStatus            EscrowStatus?
  escrowCheckoutUrl       String?
  /// Estimated escrow / protection fee charged to buyer (USD cents).
  escrowFeeCents          Int                @default(0)
  /// When escrow provider confirmed payout / release to seller.
  fundsReleasedAt         DateTime?
  /// Trustap guest buyer id (`1-…`) created for this checkout when using guest pay.
  trustapBuyerUserId      String?
  /// Admin: block buyer-initiated release until cleared.
  escrowReleasePaused     Boolean            @default(false)
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  /// When set (auction win unpaid), buyer must pay before this instant or the order expires.
  paymentDeadlineAt       DateTime?
  liveShippingSessionId   String?
  liveShippingSession     LiveShippingSession? @relation(fields: [liveShippingSessionId], references: [id], onDelete: SetNull)
  buyerAddressId          String?
  buyerAddress            Address?    @relation("OrderBuyerAddress", fields: [buyerAddressId], references: [id], onDelete: SetNull)
  sellerShipFromAddressId String?
  sellerShipFromAddress   Address?    @relation("OrderSellerShipFromAddress", fields: [sellerShipFromAddressId], references: [id], onDelete: SetNull)
  liveShippingSessionItem LiveShippingSessionItem?
  inventoryHolds          LiveAuctionInventoryHold[]
  layaway                 Layaway?
  shippoShipmentId        String?
  shippoTransactionId     String?
  carrier           String?
  service           String?
  trackingNumber    String?
  trackingUrl       String?
  labelUrl          String?
  shippingStatus    String?
  shippedAt         DateTime?
  /// Buyer shipping paid on this order (cents), set when payment clears. For margin vs label cost.
  shippingChargedCents   Int?
  /// Carrier label price from Shippo (cents) when a label is purchased.
  shippingLabelCostCents Int?
  /// Seller payout lifecycle (instant after delivery vs standard hold).
  payoutStatus             OrderPayoutStatus @default(pending)
  deliveryConfirmedAt      DateTime?
  payoutEligibleAt         DateTime?
  payoutReleasedAt         DateTime?
  payoutBlockedReason      String?
  payoutMethod             OrderPayoutMethod @default(standard)
  payoutReserveAmountCents Int               @default(0)
  payoutHoldUntil          DateTime?
  /// When a valid Shippo label was created (instant payout trigger).
  labelCreatedAt           DateTime?
  /// First carrier acceptance scan (fast payout trigger).
  carrierAcceptedAt        DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([escrowTransactionId])
  @@index([liveShippingSessionId])
  @@index([sellerId, payoutStatus])
}

/// Persistent seller metrics for payout tier eligibility and risk review.
model SellerPayoutMetrics {
  id                        String            @id @default(cuid())
  sellerId                  String            @unique
  seller                    User              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  lifetimeGmvUsd            Float             @default(0)
  completedOrders           Int               @default(0)
  cancelledOrders           Int               @default(0)
  accountStanding           AccountStanding   @default(good)
  trackingComplianceRate    Float             @default(1)
  cancellationRate          Float             @default(0)
  chargebackRate            Float             @default(0)
  disputeRate               Float             @default(0)
  accountAgeDays            Int               @default(0)
  fraudStatus               SellerFraudStatus @default(none)
  unresolvedDisputeCount    Int               @default(0)
  excessiveShippingDelayCount Int             @default(0)
  dailyInstantPayoutUsd       Float             @default(0)
  dailyInstantPayoutResetAt   DateTime?
  outstandingInstantPayoutUsd Float             @default(0)
  lifetimeInstantPayoutUsd    Float             @default(0)
  lastRecalculatedAt        DateTime          @default(now())
  createdAt                 DateTime          @default(now())
  updatedAt                 DateTime          @updatedAt

  @@index([lastRecalculatedAt])
}

/// Marketplace layaway agreement (one active plan per listing; one active plan per buyer platform-wide).
model Layaway {
  id                  String           @id @default(cuid())
  listingId           String           @unique
  listing             Listing          @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyerId             String
  buyer               User             @relation("LayawayBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId            String
  seller              User             @relation("LayawaySeller", fields: [sellerId], references: [id], onDelete: Cascade)
  orderId             String           @unique
  order               Order            @relation(fields: [orderId], references: [id], onDelete: Restrict)
  planType            LayawayPlanType
  status              LayawayStatus    @default(active)
  originalPriceUsd    Float
  shippingPriceUsd    Float            @default(0)
  depositAmountUsd    Float
  amountPaidUsd       Float            @default(0)
  remainingBalanceUsd Float
  startedAt           DateTime         @default(now())
  dueAt               DateTime
  completedAt         DateTime?
  defaultedAt         DateTime?
  termsAcknowledgedAt DateTime
  /// Last reminder milestone day sent (7, 14, 21, etc.) to avoid duplicate nudges.
  lastReminderDay     Int?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  payments  LayawayPayment[]
  auditLogs LayawayAuditLog[]

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([status, dueAt])
}

model LayawayPayment {
  id                      String             @id @default(cuid())
  layawayId               String
  layaway                 Layaway            @relation(fields: [layawayId], references: [id], onDelete: Cascade)
  amountUsd               Float
  kind                    LayawayPaymentKind
  status                  String             @default("pending")
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paidAt                  DateTime?
  createdAt               DateTime           @default(now())

  @@index([layawayId, createdAt])
  @@index([stripeCheckoutSessionId])
  @@index([stripePaymentIntentId])
}

model LayawayAuditLog {
  id          String   @id @default(cuid())
  layawayId   String
  layaway     Layaway  @relation(fields: [layawayId], references: [id], onDelete: Cascade)
  action      String
  actorUserId String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([layawayId, createdAt])
}

/// Admin-tracked sales tax nexus — gates Stripe Tax collection per US state.
model TaxNexusState {
  stateCode    String   @id
  label        String
  enabled      Boolean  @default(false)
  registeredAt DateTime?
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LiveShippingSession {
  id                String   @id @default(cuid())
  buyerId           String
  buyer             User     @relation("LiveShippingSessionsBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId          String
  seller            User     @relation("LiveShippingSessionsSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  liveShowId        String
  liveShow          LiveRoom @relation(fields: [liveShowId], references: [id], onDelete: Cascade)
  destinationAddressId String?
  pricingWeightOz   Float    @default(0)
  shippingCostCents Int      @default(0)
  capReached        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  orders            Order[]
  items             LiveShippingSessionItem[]

  @@unique([buyerId, sellerId, liveShowId, destinationAddressId])
  @@index([buyerId, liveShowId, sellerId])
}

model LiveShippingSessionItem {
  id                  String              @id @default(cuid())
  sessionId           String
  session             LiveShippingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  orderId             String
  order               Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId           String
  listing             Listing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  baseWeightOz        Float
  incrementalWeightOz Float
  appliedWeightOz     Float
  createdAt           DateTime            @default(now())

  @@unique([orderId])
  @@index([sessionId, createdAt])
}

/// Inbound webhook audit trail (Stripe / Shippo). Inspect when debugging payment or tracking issues.
model WebhookEventLog {
  id          String   @id @default(cuid())
  source      String
  /// Provider event name, e.g. `checkout.session.completed` or `track_updated`.
  eventType   String
  /// Stripe event id when available; used for idempotency.
  externalId  String?
  payload     String   @default("")
  processed   Boolean  @default(false)
  error       String?
  createdAt   DateTime @default(now())

  @@index([source, createdAt])
  @@index([source, externalId])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

enum MessageConversationKind {
  buyer_seller
  offer_negotiation
  order_support
  trade
  live_networking
  system
}

enum MessageThreadInbox {
  primary
  request
}

enum MessageKind {
  user
  system
}

model MessageThread {
  id               String                  @id @default(cuid())
  buyerId          String
  sellerId         String
  listingId        String
  /// Stable thread key: `listing:{id}`, `live:{roomId}`, `order:{id}`, etc.
  anchorKey        String                  @default("")
  conversationKind MessageConversationKind @default(buyer_seller)
  inbox            MessageThreadInbox      @default(primary)
  offerId          String?
  orderId          String?
  liveRoomId       String?
  buyer            User                    @relation("ThreadBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller           User                    @relation("ThreadSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  listing          Listing                 @relation(fields: [listingId], references: [id], onDelete: Cascade)
  messages         Message[]
  participants     MessageThreadParticipant[]
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@unique([buyerId, sellerId, anchorKey])
  @@index([buyerId, inbox, updatedAt])
  @@index([sellerId, inbox, updatedAt])
}

model MessageThreadParticipant {
  id        String        @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  pinnedAt  DateTime?
  starred   Boolean       @default(false)
  muted     Boolean       @default(false)
  blocked   Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([threadId, userId])
  @@index([userId])
}

model Message {
  id          String       @id @default(cuid())
  threadId    String
  thread      MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User         @relation("MsgSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User         @relation("MsgRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  listingId   String?
  listing     Listing?     @relation(fields: [listingId], references: [id], onDelete: SetNull)
  kind        MessageKind  @default(user)
  systemEvent String?
  body        String
  readAt      DateTime?
  createdAt   DateTime     @default(now())

  @@index([threadId, createdAt])
}

/// Audit trail for instant payout eligibility decisions and admin overrides.
model PayoutEligibilityAuditLog {
  id             String   @id @default(cuid())
  sellerId       String
  seller         User     @relation("PayoutAuditSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  orderId        String?
  adminId        String?
  admin          User?    @relation("PayoutAuditAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  action         String
  previousStatus String?
  newStatus      String?
  reason         String?
  createdAt      DateTime @default(now())

  @@index([sellerId, createdAt])
  @@index([orderId, createdAt])
}

/// Universal user/content report — shared web + mobile intake.
model Report {
  id              String           @id @default(cuid())
  reporterUserId  String
  reporter        User             @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  targetType      ReportTargetType
  targetId        String
  reason          ReportReason
  description     String           @default("")
  status          ReportStatus     @default(open)
  assignedAdminId String?
  assignedAdmin   User?            @relation("ReportAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  moderationNotes String           @default("")
  liveRoomId      String?
  liveRoom        LiveRoom?        @relation(fields: [liveRoomId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  resolvedAt      DateTime?
  updatedAt       DateTime         @updatedAt

  auditLogs ReportAuditLog[]

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterUserId, createdAt])
  @@index([assignedAdminId])
}

model ReportAuditLog {
  id          String   @id @default(cuid())
  reportId    String
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  action      String
  detail      String?
  createdAt   DateTime @default(now())

  @@index([reportId, createdAt])
}

/// Host-assigned live room moderators (chat/bid governance — distinct from tip moderator).
model LiveRoomModerator {
  id               String    @id @default(cuid())
  liveRoomId       String
  liveRoom         LiveRoom  @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  userId           String
  user             User      @relation("LiveRoomModeratorUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedByUserId String
  assignedBy       User      @relation("LiveRoomModeratorAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Cascade)
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())

  @@unique([liveRoomId, userId])
  @@index([liveRoomId, revokedAt])
}

/// Append-only moderation actions for live rooms (mute, kick, ban, etc.).
model LiveRoomModerationAction {
  id              String                       @id @default(cuid())
  liveRoomId      String
  liveRoom        LiveRoom                     @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  targetUserId    String?
  targetUser      User?                        @relation("LiveRoomModerationTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  moderatorUserId String
  moderator       User                         @relation("LiveRoomModerationActor", fields: [moderatorUserId], references: [id], onDelete: Cascade)
  actionType      LiveRoomModerationActionType
  reason          String                       @default("")
  targetMessageId String?
  metadata        Json?
  expiresAt       DateTime?
  createdAt       DateTime                     @default(now())

  @@index([liveRoomId, targetUserId, createdAt])
  @@index([liveRoomId, actionType, createdAt])
}

/// Post-show stream replay metadata (IVS recording URL or manifest).
model LiveStreamReplay {
  id              String    @id @default(cuid())
  liveRoomId      String
  liveRoom        LiveRoom  @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  sellerId        String
  seller          User      @relation("LiveStreamReplaySeller", fields: [sellerId], references: [id], onDelete: Cascade)
  streamSessionId String?
  replayUrl       String
  durationSeconds Int?
  startedAt       DateTime
  endedAt         DateTime
  deletedAt       DateTime?
  deletedByAdminId String?
  createdAt       DateTime  @default(now())

  @@index([liveRoomId, createdAt])
  @@index([sellerId, createdAt])
}

/// Admin-generated dispute / moderation evidence package (JSON summary + links).
model DisputeEvidenceBundle {
  id                   String                @id @default(cuid())
  orderId              String?
  liveRoomId           String?
  reportId             String?
  generatedByAdminId   String?
  generatedByAdmin     User?                 @relation("DisputeEvidenceAdmin", fields: [generatedByAdminId], references: [id], onDelete: SetNull)
  status               DisputeEvidenceStatus @default(pending)
  summaryJson          Json?
  errorMessage         String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  @@index([orderId, createdAt])
  @@index([liveRoomId, createdAt])
  @@index([reportId, createdAt])
}

/// Cross-domain trust & safety audit trail (moderation, evidence, admin overrides).
model TrustModerationAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  action      String
  targetType  String?
  targetId    String?
  liveRoomId  String?
  detail      Json?
  createdAt   DateTime @default(now())

  @@index([liveRoomId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
}
