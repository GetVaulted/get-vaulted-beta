  body            String
  messageType     LiveRoomMessageType @default(chat)
  deletedAt       DateTime?
  deletedByUserId String?
  deletedBy       User?               @relation("LiveRoomMessageDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime            @default(now())

  @@index([liveRoomId, createdAt])
}

model ListingImage {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  url       String
  sortOrder Int     @default(0)
}

model Offer {
  id               String   @id @default(cuid())
  listingId        String
  listing          Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sellerId         String
  seller           User     @relation("OfferSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyerId          String
  buyer            User     @relation("OfferBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  amountUsd        Float
  message          String?
  status           String   @default("pending")
  counterAmountUsd Float?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model Bid {
  id                String   @id @default(cuid())
  listingId         String
  listing           Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  bidderId          String
  bidder            User     @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  /// Public price on the listing after this bid event (proxy-visible amount).
  amountUsd         Float
  /// Bidder’s maximum (proxy); never exposed to other users via listing APIs.
  maxBidUsd         Float?
  /// Confirmed ship-to when bid was placed (marketplace); used if this bidder wins.
  shipRecipientName String?
  shipAddress       String?
  shipCity          String?
  shipState         String?
  shipZip           String?
  shipCountry       String?
  /// Payment method label to charge when the bidder wins (e.g. placeholder until PSP is wired).
  paymentLabel      String?
  createdAt         DateTime @default(now())

  // Bid placement/proxy-resolution reads all bids for a listing ordered by time.
  @@index([listingId, createdAt])
  // "Bids I've placed" style lookups.
  @@index([bidderId, createdAt])
}

model Order {
  id                         String                     @id @default(cuid())
  listingId                  String                     @unique
  listing                    Listing                    @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyerId                    String
  buyer                      User                       @relation("OrderBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId                   String
  seller                     User                       @relation("OrderSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  itemPriceUsd               Float
  shippingPriceUsd           Float                      @default(0)
  /// Tax / fees placeholder (USD); buyer-paid sales tax synced from Stripe Tax.
  taxUsd                     Float                      @default(0)
  /// Buyer-paid sales tax in cents (Stripe Tax); excluded from seller payout and platform fee base.
  taxAmountCents             Int                        @default(0)
  taxProvider                String?
  stripeTaxCalculationId     String?
  /// Stripe Tax Transaction id (`tax_…`) created after payment via createFromCalculation.
  stripeTaxTransactionId     String?
  /// Stripe Tax Transaction reversal id after a refund that reverses the tax transaction.
  stripeTaxTransactionReversalId String?
  /// US state code where tax was collected (buyer ship-to jurisdiction).
  taxJurisdictionState       String?
  /// Item subtotal included in tax calculation (cents).
  taxTaxableSubtotalCents    Int                        @default(0)
  /// Shipping amount included in tax calculation (cents).
  taxShippingTaxableCents    Int                        @default(0)
  /// When tax was calculated for this order.
  taxCalculatedAt            DateTime?
  /// Sales tax reversed on refunds (cents).
  taxRefundedCents           Int                        @default(0)
  /// Why tax was collected: marketplace_facilitator, direct_nexus, etc.
  taxCollectionBasis         String?
  totalUsd                   Float
  /// Legacy lifecycle: pending → paid → shipped (mirrors fulfillment where applicable).
  status                     String                     @default("pending")
  /// Stripe payment lifecycle; webhooks are source of truth.
  paymentStatus              String                     @default("paid")
  /// Shipment / label lifecycle.
  fulfillmentStatus          String                     @default("pending")
  shipRecipientName          String
  shipAddress                String
  shipCity                   String
  shipState                  String
  shipZip                    String
  shipCountry                String
  paymentLabel               String                     @default("placeholder")
  /// Marketplace: Stripe Checkout vs third-party escrow (e.g. Trustap).
  paymentMethod              OrderPaymentMethod         @default(stripe)
  /// Escrow integration id (e.g. Trustap transaction id). Null when `paymentMethod` is stripe.
  escrowProvider             String?
  escrowTransactionId        String?
  escrowStatus               EscrowStatus?
  escrowCheckoutUrl          String?
  /// Estimated escrow / protection fee charged to buyer (USD cents).
  escrowFeeCents             Int                        @default(0)
  /// When escrow provider confirmed payout / release to seller.
  fundsReleasedAt            DateTime?
  /// Trustap guest buyer id (`1-…`) created for this checkout when using guest pay.
  trustapBuyerUserId         String?
  /// Admin: block buyer-initiated release until cleared.
  escrowReleasePaused        Boolean                    @default(false)
  /// Atomic mutex around the escrow-provider release call — prevents two concurrent release
  /// triggers (webhook + cron + admin action racing) from both calling the provider for the
  /// same order. Set true right before calling the provider, cleared on success or failure.
  escrowReleaseInFlight      Boolean                    @default(false)
  stripeCheckoutSessionId    String?
  stripePaymentIntentId      String?
  /// Platform Charge id (`ch_…`) for the buyer payment.
  stripeChargeId             String?
  /// Charge BalanceTransaction id (`txn_…`) — source of truth for card processing fee.
  stripeBalanceTransactionId String?
  /// Actual Stripe card processing fee from balance_transaction.fee (cents).
  stripeProcessingFeeCents   Int?
  /// Application fee amount kept by the platform (cents), from Charge/ApplicationFee when available.
  /// NOTE: On untaxed Connect charges this may equal platform fee + seller-paid Stripe processing —
  /// do NOT use as the seller-facing "Get Vaulted fee". Prefer `platformFeeCents` below.
  stripeApplicationFeeCents  Int?
  /// Immutable Get Vaulted platform fee (cents) snapshot at charge time — item subtotal only.
  platformFeeCents           Int?
  /// Fee percent applied at charge time (e.g. 6.75). Never recompute from today's admin config.
  platformFeePercentApplied  Float?
  /// Fee basis in cents at charge time (item subtotal; excludes shipping/tax/tips).
  platformFeeBasisCents      Int?
  /// Prior completed live-show GMV (USD) used for tier at charge time. Null for marketplace.
  platformFeePriorShowGmvUsd Float?
  /// True when a seller-specific platform fee override was applied at charge time.
  platformFeeSellerOverrideApplied Boolean @default(false)
  /// Net to platform balance from the charge BT (cents). Does not include later Tax API usage bills.
  stripeNetCents             Int?
  /// Payment processor abstraction — Stripe default; PayPal/Venmo when enabled separately.
  paymentProcessor           PaymentProcessor           @default(STRIPE)
  walletPaymentMethodType    WalletPaymentMethodType    @default(card)
  processorPaymentId         String?
  processorCustomerId        String?
  processorTransferId        String?
  sellerPayoutProcessor      SellerPayoutProcessor      @default(STRIPE)
  /// PayPal Payouts fee (cents) when seller rail is PAYPAL; null when unused or unknown.
  paypalPayoutFeeCents       Int?
  /// Async PayPal payout lifecycle: pending | success | failed | returned | unclaimed.
  paypalPayoutStatus         String?
  walletPaymentMethodId      String?
  /// When set (auction win unpaid), buyer must pay before this instant or the order expires.
  paymentDeadlineAt          DateTime?
  liveShippingSessionId      String?
  liveShippingSession        LiveShippingSession?       @relation(fields: [liveShippingSessionId], references: [id], onDelete: SetNull)
  buyerAddressId             String?
  buyerAddress               Address?                   @relation("OrderBuyerAddress", fields: [buyerAddressId], references: [id], onDelete: SetNull)
  sellerShipFromAddressId    String?
  sellerShipFromAddress      Address?                   @relation("OrderSellerShipFromAddress", fields: [sellerShipFromAddressId], references: [id], onDelete: SetNull)
  liveShippingSessionItem    LiveShippingSessionItem?
  variantPurchaseFulfillment LiveItemVariantPurchase[]  @relation("VariantPurchaseFulfillmentOrder")
  breakSpotFulfillment       BreakSpot?                 @relation("BreakSpotFulfillmentOrder")
  inventoryHolds             LiveAuctionInventoryHold[]
  layaway                    Layaway?
  shippoShipmentId           String?
  shippoTransactionId        String?
  carrier                    String?
  service                    String?
  trackingNumber             String?
  trackingUrl                String?
  labelUrl                   String?
  shippingStatus             String?
  shippedAt                  DateTime?
  /// Buyer shipping paid on this order (cents), set when payment clears. For margin vs label cost.
  shippingChargedCents       Int?
  /// Carrier label price from Shippo (cents) when a label is purchased.
  shippingLabelCostCents     Int?
  /// Stripe Connect destination-charge transfer id (tr_…) for this order's payment.
  stripeTransferId           String?
  /// Latest Stripe transfer reversal id (trr_…) that clawed back a Get Vaulted label cost.
  shippingLabelCostReversalId String?
  /// Shippo transaction id that was last successfully charged to the seller (idempotency).
  shippingLabelCostChargedShippoTransactionId String?
  /// Cumulative label cost reversed from the seller Connect balance (cents). Used for payout net.
  shippingLabelCostReversedCents Int                    @default(0)
  /// Seller subsidy when cap/free shipping applies (cents).
  sellerShippingSubsidyCents Int                        @default(0)
  shippingCapApplied         Boolean                    @default(false)
  freeShippingApplied        Boolean                    @default(false)
  estimatedLabelCostCents    Int?
  shippingTermsSnapshotJson  Json?
  shippingTermsVersion       Int?
  shippoRateId               String?
  /// Seller payout lifecycle (instant after delivery vs standard hold).
  payoutStatus               OrderPayoutStatus          @default(pending)
  deliveryConfirmedAt        DateTime?
  payoutEligibleAt           DateTime?
  payoutReleasedAt           DateTime?
  payoutBlockedReason        String?
  payoutMethod               OrderPayoutMethod          @default(standard)
  payoutReserveAmountCents   Int                        @default(0)
  payoutHoldUntil            DateTime?
  /// Referral + platform credit applied beyond what the platform fee could absorb (cents) — the
  /// gap Get Vaulted funds directly so the seller still receives full sale price. Null when no
  /// shortfall exists on this order.
  sellerCreditShortfallCents Int?
  /// Stripe Connect Transfer id (`tr_…`) that funded the shortfall above, once sent.
  sellerCreditShortfallTransferId String?
  sellerCreditShortfallFundedAt   DateTime?
  /// Set when the automatic top-up transfer failed (no Connect account, low platform balance,
  /// Stripe error) — paired with `payoutStatus = manual_review` so it surfaces in admin queues.
  sellerCreditShortfallFailedAt   DateTime?
  sellerCreditShortfallFailureDetail String?
  sellerCreditShortfallIdempotencyKey String?
  /// When a valid Shippo label was created (instant payout trigger).
  labelCreatedAt             DateTime?
  /// First carrier acceptance scan (fast payout trigger).
  carrierAcceptedAt          DateTime?
  refundRequests             OrderRefundRequest[]
  shipmentPackages           ShipmentPackage[]
  labelFinances              ShipmentLabelFinance[]
  referralCredits            ReferralCredit[]           @relation("ReferralCreditSourceOrder")
  /// Referral credit applied to this order's charge (USD) — buyer-facing order summary + audit.
  /// Informational only; ledger truth is `ReferralCredit` rows with `spentOrderId` = this order.
  referralCreditAppliedUsd   Float                      @default(0)
  /// Platform / giveaway store credit applied to this order's charge (USD).
  platformCreditAppliedUsd   Float                      @default(0)
  platformCreditsSpent       PlatformCredit[]           @relation("PlatformCreditSpentOrder")
  createdAt                  DateTime                   @default(now())
  updatedAt                  DateTime                   @updatedAt
  /// When the buyer's payment actually cleared (Stripe charge.created once the async ledger
  /// backfill runs; a `new Date()` placeholder is written synchronously the moment paymentStatus
  /// first flips to a paid-bucket value, so this is never null for any order that ever reached
  /// paid/layaway_completed/refunded/chargeback). Financial reconciliation against Stripe MUST use
  /// this field, not createdAt — an order can be created well before it's actually paid (deferred
  /// auction-win payment, saved-card retries, layaway). Operational reports (order lists, seller
  /// sales history, buyer order history) intentionally keep using createdAt — do not repoint those.
  /// See web/docs/financial-reconciliation-audit-2026-08.md.
  paidAt                     DateTime?
  /// Provenance of `paidAt` — set ONLY when conclusively known:
  /// - stripe_authoritative: paidAt is the real Stripe Charge.created (persistOrderStripeChargeLedger).
  /// - created_at_fallback: no recoverable Stripe charge existed (no PaymentIntent, or the Stripe
  ///   fetch failed) — paidAt was copied from createdAt and must NOT be treated as Stripe-verified.
  /// Null means "not yet determined" (a placeholder paidAt was just written and the async Stripe
  /// ledger upgrade hasn't run yet) OR "not applicable" (escrow / $0 giveaway orders, which never
  /// have a Stripe charge and whose paidAt is a genuine non-Stripe confirmation moment, not a
  /// fallback copy of createdAt). Never infer Stripe-verification from a null value either way —
  /// query this field explicitly.
  paidAtSource               OrderPaidAtSource?

  @@index([escrowTransactionId])
  @@index([liveShippingSessionId])
  @@index([sellerId, payoutStatus])
  // Buyer order history ("My Orders").
  @@index([buyerId, createdAt])
  // Seller sales history, in addition to the payoutStatus-scoped index above.
  @@index([sellerId, createdAt])
  // Admin orders dashboard + fulfillment/finance summaries filter by status.
  @@index([status, createdAt])
  // processAuctionPaymentExpiries scans unpaid orders past their payment deadline.
  @@index([paymentStatus, paymentDeadlineAt])
  // Financial reconciliation's payment-date window (admin-reconciliation.ts, prismaSaleAtFilter).
  @@index([paidAt])
  // Backfill verification: count STRIPE_AUTHORITATIVE vs CREATED_AT_FALLBACK.
  @@index([paidAtSource])
}

/// Provenance tag for Order.paidAt — see the field comment. Financial reconciliation must be able
/// to tell a real Stripe-verified payment date apart from a createdAt-copied stand-in.
enum OrderPaidAtSource {
  stripe_authoritative
  created_at_fallback
}

/// Live show order cancel / return refund workflow (buyer request → seller → optional support escalation).
model OrderRefundRequest {
  id                   String                   @id @default(cuid())
  orderId              String
  order                Order                    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  kind                 OrderRefundRequestKind
  status               OrderRefundRequestStatus @default(pending_seller)
  buyerId              String
  buyer                User                     @relation("OrderRefundRequestBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId             String
  seller               User                     @relation("OrderRefundRequestSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  reason               String
  photoUrls            String[]                 @default([])
  sellerDenyReason     String?
  supportNote          String?
  returnTrackingNumber String?
  returnCarrier        String?
  sellerDirect         Boolean                  @default(false)
  escalatedAt          DateTime?
  sellerRespondedAt    DateTime?
  supportResolvedAt    DateTime?
  returnReceivedAt     DateTime?
  refundedAt           DateTime?
  stripeRefundId       String?
  /// Refund id from whichever processor actually completed this refund — Stripe refund (`re_…`)
  /// or a PayPal/Venmo capture-refund id. Populated for every processor; `stripeRefundId` above
  /// stays Stripe-only (kept for backward compatibility with existing tooling that reads it
  /// directly) rather than being overloaded to also hold non-Stripe ids — see bug #18.
  processorRefundId    String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt

  @@index([orderId, createdAt])
  @@index([sellerId, status])
  @@index([buyerId, status])
  @@index([status, escalatedAt])
}

enum ReferralCreditRole {
  referrer
  referee
}

/// `pending` → hold window open (source order could still refund/dispute).
/// `available` → spendable.
/// `reserved` → earmarked against an in-flight checkout (released back to `available` if that
/// checkout never completes).
/// `spent` → applied to a completed order.
/// `voided` → clawed back (source order refunded/disputed before hold cleared, or fraud block).
enum ReferralCreditStatus {
  pending
  available
  reserved
  spent
  voided
}

/// Referral program ledger row. Each qualifying referred-friend order creates exactly two rows
/// (one `referrer`, one `referee`) via the `@@unique([sourceOrderId, role])` idempotency guard —
/// safe to re-attempt on webhook replay. Pure marketing-expense credit: never reduces the
/// seller's proceeds or the platform fee on the order it's spent on.
model ReferralCredit {
  id             String               @id @default(cuid())
  userId         String
  user           User                 @relation("ReferralCreditOwner", fields: [userId], references: [id], onDelete: Cascade)
  role           ReferralCreditRole
  amountUsd      Float
  status         ReferralCreditStatus @default(pending)
  /// The referred friend's qualifying first order that earned this credit pair.
  sourceOrderId  String
  sourceOrder    Order                @relation("ReferralCreditSourceOrder", fields: [sourceOrderId], references: [id], onDelete: Cascade)
  /// Becomes spendable at this instant, assuming no clawback (source order's return/dispute hold).
  availableAt    DateTime
  /// Opaque checkout reference (Stripe Checkout Session id, etc.) while `status = reserved`.
  reservedForRef String?
  reservedAt     DateTime?
  /// Order this credit was ultimately applied to, once `status = spent`.
  spentOrderId   String?
  spentAt        DateTime?
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt

  @@unique([sourceOrderId, role])
  @@index([userId, status])
  @@index([status, availableAt])
}

// ---------------------------------------------------------------------------
// Platform giveaway campaigns (site-wide; separate from live-room LiveGiveaway)
// ---------------------------------------------------------------------------

enum GiveawayCampaignStatus {
  draft
  scheduled
  active
  paused
  ended
  cancelled
}

enum GiveawayPrizeType {
  platform_credit
  cash
  product
  custom
}

enum GiveawayEntryType {
  existing_user
  new_signup
  referral
  purchase
  manual_adjustment
}

enum GiveawayDrawStatus {
  pending_confirm
  confirmed
  superseded
}

enum PlatformCreditStatus {
  available
  reserved
  spent
  voided
}

enum PlatformCreditSourceType {
  giveaway_prize
  admin_grant
}

/// Site-wide giveaway campaign (e.g. $500 Get Vaulted Credit). Configurable from admin.
model GiveawayCampaign {
  id                 String                 @id @default(cuid())
  slug               String                 @unique
  title              String
  description        String                 @default("")
  rulesText          String                 @default("")
  prizeType          GiveawayPrizeType      @default(platform_credit)
  prizeAmountUsd     Float                  @default(0)
  prizeLabel         String                 @default("")
  prizeMetadata      Json?
  status             GiveawayCampaignStatus @default(draft)
  startsAt           DateTime
  endsAt             DateTime
  winnerUserId       String?
  winnerUser         User?                  @relation("GiveawayCampaignWinner", fields: [winnerUserId], references: [id], onDelete: SetNull)
  winnerConfirmedAt  DateTime?
  prizeAwardedAt     DateTime?
  createdAt          DateTime               @default(now())
  updatedAt          DateTime               @updatedAt

  entries    GiveawayEntryLedger[]
  fraudFlags GiveawayFraudFlag[]
  draws      GiveawayDraw[]

  @@index([status, startsAt, endsAt])
}

/// Append-only entry ledger — never store entry counts on User.
model GiveawayEntryLedger {
  id             String            @id @default(cuid())
  campaignId     String
  campaign       GiveawayCampaign  @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId         String
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  entryType      GiveawayEntryType
  quantity       Int               @default(1)
  source         String
  idempotencyKey String            @unique
  metadata       Json?
  createdAt      DateTime          @default(now())

  @@index([campaignId, userId])
  @@index([campaignId, createdAt])
  @@index([userId, createdAt])
}

model GiveawayFraudFlag {
  id         String            @id @default(cuid())
  campaignId String?
  campaign   GiveawayCampaign? @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  reason     String
  detail     String            @default("")
  createdAt  DateTime          @default(now())

  @@index([campaignId, userId])
  @@index([userId, createdAt])
  @@unique([campaignId, userId, reason])
}

model GiveawayDraw {
  id             String             @id @default(cuid())
  campaignId     String
  campaign       GiveawayCampaign   @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  winnerUserId   String
  winnerUser     User               @relation("GiveawayDrawWinner", fields: [winnerUserId], references: [id], onDelete: Cascade)
  totalEntries   Int
  totalEntrants  Int
  drawSeed       String
  drawHash       String
  isRedraw       Boolean            @default(false)
  redrawReason   String?
  adminUserId    String
  adminUser      User               @relation("GiveawayDrawAdmin", fields: [adminUserId], references: [id], onDelete: Cascade)
  status         GiveawayDrawStatus @default(pending_confirm)
  createdAt      DateTime           @default(now())

  @@index([campaignId, createdAt])
}

/// Spendable Get Vaulted Credit (giveaway prizes, admin grants). Not withdrawable.
model PlatformCredit {
  id             String                   @id @default(cuid())
  userId         String
  user           User                     @relation("PlatformCreditOwner", fields: [userId], references: [id], onDelete: Cascade)
  amountUsd      Float
  status         PlatformCreditStatus     @default(available)
  sourceType     PlatformCreditSourceType
  sourceRef      String
  reservedForRef String?
  reservedAt     DateTime?
  spentOrderId   String?
  spentOrder     Order?                   @relation("PlatformCreditSpentOrder", fields: [spentOrderId], references: [id], onDelete: SetNull)
  spentAt        DateTime?
  voidedAt       DateTime?
  voidReason     String?
  createdAt      DateTime                 @default(now())
  updatedAt      DateTime                 @updatedAt

  @@unique([sourceType, sourceRef])
  @@index([userId, status])
}

/// Persistent seller metrics for payout tier eligibility and risk review.
model SellerPayoutMetrics {
  id                          String            @id @default(cuid())
  sellerId                    String            @unique
  seller                      User              @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  lifetimeGmvUsd              Float             @default(0)
  completedOrders             Int               @default(0)
  cancelledOrders             Int               @default(0)
  accountStanding             AccountStanding   @default(good)
  trackingComplianceRate      Float             @default(1)
  cancellationRate            Float             @default(0)
  chargebackRate              Float             @default(0)
  disputeRate                 Float             @default(0)
  accountAgeDays              Int               @default(0)
  fraudStatus                 SellerFraudStatus @default(none)
  unresolvedDisputeCount      Int               @default(0)
  excessiveShippingDelayCount Int               @default(0)
  dailyInstantPayoutUsd       Float             @default(0)
  dailyInstantPayoutCount     Int               @default(0)
  dailyInstantPayoutResetAt   DateTime?
  outstandingInstantPayoutUsd Float             @default(0)
  lifetimeInstantPayoutUsd    Float             @default(0)
  lastRecalculatedAt          DateTime          @default(now())
  createdAt                   DateTime          @default(now())
  updatedAt                   DateTime          @updatedAt

  @@index([lastRecalculatedAt])
}

/// Marketplace layaway agreement (one active plan per listing; one active plan per buyer platform-wide).
model Layaway {
  id                  String          @id @default(cuid())
  listingId           String          @unique
  listing             Listing         @relation(fields: [listingId], references: [id], onDelete: Restrict)
  buyerId             String
  buyer               User            @relation("LayawayBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId            String
  seller              User            @relation("LayawaySeller", fields: [sellerId], references: [id], onDelete: Cascade)
  orderId             String          @unique
  order               Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  planType            LayawayPlanType
  status              LayawayStatus   @default(active)
  originalPriceUsd    Float
  shippingPriceUsd    Float           @default(0)
  depositAmountUsd    Float
  amountPaidUsd       Float           @default(0)
  remainingBalanceUsd Float
  startedAt           DateTime        @default(now())
  dueAt               DateTime
  completedAt         DateTime?
  defaultedAt         DateTime?
  termsAcknowledgedAt DateTime
  /// Last reminder milestone day sent (7, 14, 21, etc.) to avoid duplicate nudges.
  lastReminderDay     Int?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  payments  LayawayPayment[]
  auditLogs LayawayAuditLog[]

  @@index([buyerId, status])
  @@index([sellerId, status])
  @@index([status, dueAt])
}

model LayawayPayment {
  id                      String             @id @default(cuid())
  layawayId               String
  layaway                 Layaway            @relation(fields: [layawayId], references: [id], onDelete: Cascade)
  amountUsd               Float
  kind                    LayawayPaymentKind
  status                  String             @default("pending")
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paidAt                  DateTime?
  createdAt               DateTime           @default(now())

  @@index([layawayId, createdAt])
  @@index([stripeCheckoutSessionId])
  @@index([stripePaymentIntentId])
}

model LayawayAuditLog {
  id          String   @id @default(cuid())
  layawayId   String
  layaway     Layaway  @relation(fields: [layawayId], references: [id], onDelete: Cascade)
  action      String
  actorUserId String?
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([layawayId, createdAt])
}

/// Admin-tracked sales tax nexus — gates Stripe Tax collection per US state.
model TaxNexusState {
  stateCode       String    @id
  label           String
  enabled         Boolean   @default(false)
  /// marketplace_facilitator | direct_nexus | admin_enabled
  collectionBasis String    @default("marketplace_facilitator")
  registeredAt    DateTime?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

/// Informational GMV/tax volume by destination state for nexus monitoring (does not auto-enable collection).
model TaxDestinationVolumeDaily {
  id                   String   @id @default(cuid())
  stateCode            String
  orderDate            DateTime @db.Date
  taxableSalesCents    Int      @default(0)
  nonTaxableSalesCents Int      @default(0)
  taxCollectedCents    Int      @default(0)
  orderCount           Int      @default(0)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@unique([stateCode, orderDate])
  @@index([stateCode, orderDate])
}

model LiveShippingSession {
  id                             String                     @id @default(cuid())
  buyerId                        String
  buyer                          User                       @relation("LiveShippingSessionsBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  sellerId                       String
  seller                         User                       @relation("LiveShippingSessionsSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  liveShowId                     String
  liveShow                       LiveRoom                   @relation(fields: [liveShowId], references: [id], onDelete: Cascade)
  destinationAddressId           String?
  pricingWeightOz                Float                      @default(0)
  shippingCostCents              Int                        @default(0)
  capReached                     Boolean                    @default(false)
  /// Snapshot from show at session creation — honors cap advertised at first purchase.
  shippingMode                   LiveShowShippingMode?
  shippingCapCents               Int?
  shippingChargedCents           Int                        @default(0)
  estimatedEligibleShippingCents Int?
  freeShippingApplied            Boolean                    @default(false)
  estimatedLabelCostCents        Int?
  finalLabelCostCents            Int?
  sellerShippingSubsidyCents     Int                        @default(0)
  carrierPreference              LiveShowCarrierPreference?
  shippingTermsVersion           Int?
  createdAt                      DateTime                   @default(now())
  updatedAt                      DateTime                   @updatedAt
  orders                         Order[]
  items                          LiveShippingSessionItem[]
  packages                       ShipmentPackage[]

  @@unique([buyerId, sellerId, liveShowId, destinationAddressId])
  @@index([buyerId, liveShowId, sellerId])
}

model LiveShippingSessionItem {
  id                  String              @id @default(cuid())
  sessionId           String
  session             LiveShippingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  orderId             String
  order               Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  listingId           String
  listing             Listing             @relation(fields: [listingId], references: [id], onDelete: Cascade)
  baseWeightOz        Float
  incrementalWeightOz Float
  appliedWeightOz     Float
  createdAt           DateTime            @default(now())

  @@unique([orderId])
  @@index([sessionId, createdAt])
}

/// Atomic idempotency claim for Stripe webhook events (financial correctness safeguard).
/// A row is inserted (via unique `id` = Stripe event id) before processing begins; two
/// concurrent deliveries of the same event race on this insert, so only one can proceed.
/// The claim is deleted if processing throws, allowing Stripe's automatic retry (same event id,
/// non-2xx response) to reclaim and reprocess; it is kept forever on success so later replays
/// of an already-completed event are skipped. See `web/src/app/api/stripe/webhook/route.ts`.
model ProcessedStripeEvent {
  id          String   @id
  processedAt DateTime @default(now())
}

/// Idempotency for PayPal webhook event ids (payout batch / item notifications).
model ProcessedPayPalEvent {
  id          String   @id
  processedAt DateTime @default(now())
}

/// Inbound webhook audit trail (Stripe / Shippo). Inspect when debugging payment or tracking issues.
model WebhookEventLog {
  id         String   @id @default(cuid())
  source     String
  /// Provider event name, e.g. `checkout.session.completed` or `track_updated`.
  eventType  String
  /// Stripe event id when available; used for idempotency.
  externalId String?
  payload    String   @default("")
  processed  Boolean  @default(false)
  error      String?
  createdAt  DateTime @default(now())

  @@index([source, createdAt])
  @@index([source, externalId])
}

model WatchlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  listingId String
  listing   Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, listingId])
}

enum MessageConversationKind {
  buyer_seller
  offer_negotiation
  order_support
  trade
  live_networking
  system
}

enum MessageThreadInbox {
  primary
  request
}

enum MessageKind {
  user
  system
}

model MessageThread {
  id               String                     @id @default(cuid())
  buyerId          String
  sellerId         String
  listingId        String
  /// Stable thread key: `listing:{id}`, `live:{roomId}`, `order:{id}`, etc.
  anchorKey        String                     @default("")
  conversationKind MessageConversationKind    @default(buyer_seller)
  inbox            MessageThreadInbox         @default(primary)
  offerId          String?
  orderId          String?
  liveRoomId       String?
  buyer            User                       @relation("ThreadBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  seller           User                       @relation("ThreadSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  listing          Listing                    @relation(fields: [listingId], references: [id], onDelete: Cascade)
  messages         Message[]
  participants     MessageThreadParticipant[]
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  @@unique([buyerId, sellerId, anchorKey])
  @@index([buyerId, inbox, updatedAt])
  @@index([sellerId, inbox, updatedAt])
}

model MessageThreadParticipant {
  id        String        @id @default(cuid())
  threadId  String
  thread    MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  pinnedAt  DateTime?
  starred   Boolean       @default(false)
  muted     Boolean       @default(false)
  blocked   Boolean       @default(false)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([threadId, userId])
  @@index([userId])
}

/// Durable, cross-thread block between two users. Source of truth for whether a NEW thread
/// or message between the pair should be allowed — unlike `MessageThreadParticipant.blocked`,
/// which only applies to one specific thread/anchor.
model UserBlock {
  id          String   @id @default(cuid())
  blockerId   String
  blocker     User     @relation("UserBlockBlocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId   String
  blockedUser User     @relation("UserBlockBlocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

model Message {
  id          String        @id @default(cuid())
  threadId    String
  thread      MessageThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  senderId    String
  sender      User          @relation("MsgSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId String
  recipient   User          @relation("MsgRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  listingId   String?
  listing     Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)
  kind        MessageKind   @default(user)
  systemEvent String?
  body        String
  /// Optional photo attachment (Supabase Storage public URL). Messages may have text, an
  /// image, or both — `body` may be "" when the message is image-only.
  imageUrl    String?
  readAt      DateTime?
  createdAt   DateTime      @default(now())

  @@index([threadId, createdAt])
}

/// Audit trail for instant payout eligibility decisions and admin overrides.
model PayoutEligibilityAuditLog {
  id             String   @id @default(cuid())
  sellerId       String
  seller         User     @relation("PayoutAuditSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  orderId        String?
  adminId        String?
  admin          User?    @relation("PayoutAuditAdmin", fields: [adminId], references: [id], onDelete: SetNull)
  action         String
  previousStatus String?
  newStatus      String?
  reason         String?
  createdAt      DateTime @default(now())

  @@index([sellerId, createdAt])
  @@index([orderId, createdAt])
}

/// Universal user/content report — shared web + mobile intake.
model Report {
  id              String           @id @default(cuid())
  reporterUserId  String
  reporter        User             @relation("ReportReporter", fields: [reporterUserId], references: [id], onDelete: Cascade)
  targetType      ReportTargetType
  targetId        String
  reason          ReportReason
  description     String           @default("")
  status          ReportStatus     @default(open)
  assignedAdminId String?
  assignedAdmin   User?            @relation("ReportAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  moderationNotes String           @default("")
  liveRoomId      String?
  liveRoom        LiveRoom?        @relation(fields: [liveRoomId], references: [id], onDelete: SetNull)
  createdAt       DateTime         @default(now())
  resolvedAt      DateTime?
  updatedAt       DateTime         @updatedAt

  auditLogs ReportAuditLog[]

  @@index([status, createdAt])
  @@index([targetType, targetId])
  @@index([reporterUserId, createdAt])
  @@index([assignedAdminId])
}

model ReportAuditLog {
  id          String   @id @default(cuid())
  reportId    String
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  action      String
  detail      String?
  createdAt   DateTime @default(now())

  @@index([reportId, createdAt])
}

/// In-app support intake — mobile/web contact support (not trust reports).
model SupportTicket {
  id              String                @id @default(cuid())
  userId          String
  user            User                  @relation("SupportTicketUser", fields: [userId], references: [id], onDelete: Cascade)
  category        SupportTicketCategory
  subject         String
  message         String
  contactEmail    String                @default("")
  referenceType   String?
  referenceId     String?
  status          SupportTicketStatus   @default(submitted)
  adminNotes      String                @default("")
  assignedAdminId String?
  assignedAdmin   User?                 @relation("SupportTicketAssignee", fields: [assignedAdminId], references: [id], onDelete: SetNull)
  resolvedAt      DateTime?
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([assignedAdminId])
}

/// @username mention on chat or thread messages — one row per mentioned user per message.
model MessageMention {
  id                String                   @id @default(cuid())
  sourceType        MessageMentionSourceType
  sourceId          String
  mentionedUserId   String
  mentionedUser     User                     @relation("MessageMentionRecipient", fields: [mentionedUserId], references: [id], onDelete: Cascade)
  mentionedByUserId String
  mentionedBy       User                     @relation("MessageMentionAuthor", fields: [mentionedByUserId], references: [id], onDelete: Cascade)
  usernameSnapshot  String
  createdAt         DateTime                 @default(now())

  @@unique([sourceType, sourceId, mentionedUserId])
  @@index([mentionedUserId, createdAt])
  @@index([sourceType, sourceId])
}

/// Live show giveaway — open (everyone) or buyers-only (purchase + discreet AMOE).
model LiveGiveaway {
  id                 String              @id @default(cuid())
  liveRoomId         String
  liveRoom           LiveRoom            @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  kind               LiveGiveawayKind
  title              String
  prizeDescription   String              @default("")
  imageUrl           String              @default("")
  /// Official promotion rules (required for buyers giveaways).
  rulesText          String              @default("")
  /// Discreet slug for AMOE — linked only from official rules, not the live stage.
  amoeRulesSlug      String?             @unique
  status             LiveGiveawayStatus  @default(draft)
  entryOpenAt        DateTime?
  entryCloseAt       DateTime?
  drawnAt            DateTime?
  winnerUserId       String?
  winnerUser         User?               @relation("LiveGiveawayWinner", fields: [winnerUserId], references: [id], onDelete: SetNull)
  /// Paid $0 order for shipping label / seller Sales after draw.
  fulfillmentOrderId String?             @unique
  drawSeed           String?
  entryCount         Int                 @default(0)
  sortOrder          Int                 @default(0)
  createdById        String
  createdBy          User                @relation("LiveGiveawayCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  entries            LiveGiveawayEntry[]

  @@index([liveRoomId, status])
  @@index([liveRoomId, kind])
}

model LiveGiveawayEntry {
  id           String                  @id @default(cuid())
  giveawayId   String
  giveaway     LiveGiveaway            @relation(fields: [giveawayId], references: [id], onDelete: Cascade)
  userId       String
  user         User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  method       LiveGiveawayEntryMethod
  purchaseRef  String?
  amoeMeta     Json?
  /// For watch_enter rows: false when the viewer left the room (paused in drawing pool).
  activeInRoom Boolean                 @default(true)
  createdAt    DateTime                @default(now())

  @@unique([giveawayId, userId])
  @@index([giveawayId])
}

/// Host-assigned live room moderators (chat/bid governance — distinct from tip moderator).
model LiveRoomModerator {
  id               String                 @id @default(cuid())
  liveRoomId       String
  liveRoom         LiveRoom               @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  userId           String
  user             User                   @relation("LiveRoomModeratorUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedByUserId String
  assignedBy       User                   @relation("LiveRoomModeratorAssignedBy", fields: [assignedByUserId], references: [id], onDelete: Cascade)
  moderatorLevel   LiveRoomModeratorLevel @default(show)
  revokedAt        DateTime?
  createdAt        DateTime               @default(now())

  @@unique([liveRoomId, userId])
  @@index([liveRoomId, revokedAt])
}

/// Append-only moderation actions for live rooms (mute, kick, ban, etc.).
model LiveRoomModerationAction {
  id              String                       @id @default(cuid())
  liveRoomId      String
  liveRoom        LiveRoom                     @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  sellerId        String?
  seller          User?                        @relation("LiveRoomModerationSeller", fields: [sellerId], references: [id], onDelete: SetNull)
  targetUserId    String?
  targetUser      User?                        @relation("LiveRoomModerationTarget", fields: [targetUserId], references: [id], onDelete: SetNull)
  moderatorUserId String
  moderator       User                         @relation("LiveRoomModerationActor", fields: [moderatorUserId], references: [id], onDelete: Cascade)
  actionType      LiveRoomModerationActionType
  reason          String                       @default("")
  targetMessageId String?
  metadata        Json?
  expiresAt       DateTime?
  createdAt       DateTime                     @default(now())

  @@index([liveRoomId, targetUserId, createdAt])
  @@index([liveRoomId, actionType, createdAt])
  @@index([sellerId, createdAt])
}

/// Seller-wide ban from future live streams (issued by host/head mod during a show).
model SellerStreamBan {
  id             String    @id @default(cuid())
  sellerId       String
  seller         User      @relation("SellerStreamBanSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  targetUserId   String
  targetUser     User      @relation("SellerStreamBanTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  bannedByUserId String
  bannedBy       User      @relation("SellerStreamBanActor", fields: [bannedByUserId], references: [id], onDelete: Cascade)
  liveRoomId     String?
  liveRoom       LiveRoom? @relation(fields: [liveRoomId], references: [id], onDelete: SetNull)
  reason         String    @default("")
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())

  @@index([sellerId, targetUserId, revokedAt])
  @@index([targetUserId, revokedAt])
}

/// Post-show stream replay metadata (IVS recording URL or manifest).
model LiveStreamReplay {
  id               String                    @id @default(cuid())
  liveRoomId       String
  liveRoom         LiveRoom                  @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  sellerId         String
  seller           User                      @relation("LiveStreamReplaySeller", fields: [sellerId], references: [id], onDelete: Cascade)
  streamSessionId  String?
  replayUrl        String
  durationSeconds  Int?
  startedAt        DateTime
  endedAt          DateTime
  recordingStatus  LiveStreamRecordingStatus @default(pending)
  s3Bucket         String?
  s3KeyPrefix      String?
  hlsMasterKey     String?
  archiveS3Key     String?
  archiveStatus    LiveStreamArchiveStatus   @default(none)
  recordingError   String?
  deletedAt        DateTime?
  deletedByAdminId String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  @@index([liveRoomId, createdAt])
  @@index([sellerId, createdAt])
  @@index([recordingStatus, createdAt])
  @@index([archiveStatus, updatedAt])
}

/// Admin-generated dispute / moderation evidence package (JSON summary + links).
model DisputeEvidenceBundle {
  id                 String                @id @default(cuid())
  orderId            String?
  liveRoomId         String?
  reportId           String?
  generatedByAdminId String?
  generatedByAdmin   User?                 @relation("DisputeEvidenceAdmin", fields: [generatedByAdminId], references: [id], onDelete: SetNull)
  status             DisputeEvidenceStatus @default(pending)
  summaryJson        Json?
  errorMessage       String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  @@index([orderId, createdAt])
  @@index([liveRoomId, createdAt])
  @@index([reportId, createdAt])
}

/// Cross-domain trust & safety audit trail (moderation, evidence, admin overrides).
model TrustModerationAuditLog {
  id          String   @id @default(cuid())
  actorUserId String
  actor       User     @relation(fields: [actorUserId], references: [id], onDelete: Cascade)
  action      String
  targetType  String?
  targetId    String?
  liveRoomId  String?
  detail      Json?
  createdAt   DateTime @default(now())

  @@index([liveRoomId, createdAt])
  @@index([actorUserId, createdAt])
  @@index([targetType, targetId])
}

/// Seller-editable shipping profiles (seeded from platform defaults).
model SellerShippingProfile {
  id                       String                    @id @default(cuid())
  sellerId                 String
  seller                   User                      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  sourceSlug               String
  name                     String
  defaultWeightOz          Float
  defaultLengthIn          Float
  defaultWidthIn           Float
  defaultHeightIn          Float
  packageType              String                    @default("")
  bundleGroup              String                    @default("general")
  incrementalWeightOz      Float?
  maxUnitsPerParcel        Int?
  requiresSeparatePackage  Boolean                   @default(false)
  canJoinBuyerShowShipment Boolean                   @default(true)
  carrierPreference        LiveShowCarrierPreference @default(best_rate)
  defaultServicePreference String?
  isDefault                Boolean                   @default(false)
  archivedAt               DateTime?
  createdAt                DateTime                  @default(now())
  updatedAt                DateTime                  @updatedAt

  liveRooms     LiveRoom[]
  liveRoomItems LiveRoomItem[]

  @@unique([sellerId, sourceSlug])
  @@index([sellerId, archivedAt])
}

/// Admin-controlled shipping profile definitions (Live, Marketplace, Trade).
model PlatformShippingProfile {
  id                      String   @id @default(cuid())
  slug                    String   @unique
  name                    String
  defaultWeightOz         Float
  defaultLengthIn         Float
  defaultWidthIn          Float
  defaultHeightIn         Float
  packageType             String   @default("")
  bundleAllowed           Boolean  @default(true)
  requiresSeparatePackage Boolean  @default(false)
  isActive                Boolean  @default(true)
  sortOrder               Int      @default(0)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  liveRooms     LiveRoom[]
  liveRoomItems LiveRoomItem[]
  listings      Listing[]

  @@index([isActive, sortOrder])
}

enum ShipmentPackageStatus {
  estimated
  label_created
  voided
}

enum LiveShowShippingMode {
  calculated
  capped
  free
}

enum LiveShowCarrierPreference {
  usps
  ups
  best_rate
}

/// Multi-package support under one buyer/show session or single marketplace order.
model ShipmentPackage {
  id                    String                @id @default(cuid())
  liveShippingSessionId String?
  liveShippingSession   LiveShippingSession?  @relation(fields: [liveShippingSessionId], references: [id], onDelete: Cascade)
  orderId               String?
  order                 Order?                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  packageIndex          Int                   @default(0)
  weightOz              Float
  lengthIn              Float
  widthIn               Float
  heightIn              Float
  shippoShipmentId      String?
  shippoRateId          String?
  shippoTransactionId   String?
  carrier               String?
  serviceLevel          String?
  trackingNumber        String?
  labelUrl              String?
  labelCostCents        Int?
  status                ShipmentPackageStatus @default(estimated)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  labelFinance          ShipmentLabelFinance?

  @@index([liveShippingSessionId, packageIndex])
  @@index([orderId])
}

enum ShipmentLabelFinancePurpose {
  initial
  replacement
  additional_package
}

enum ShipmentLabelFinanceStatus {
  active
  replaced
  void_pending
  voided
  refund_pending
  refunded
  /// Shippo purchase failed (ERROR/INVALID); not a chargeable label cost.
  failed_purchase
}

/// Per-Shippo-transaction label clawback/credit ledger (source of truth for seller label money).
/// Order.shippingLabelCost* fields are recalculated summaries; do not treat them as full history.
model ShipmentLabelFinance {
  id                            String                       @id @default(cuid())
  orderId                       String
  order                         Order                        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  liveShippingSessionId         String?
  shipmentPackageId             String?                      @unique
  shipmentPackage               ShipmentPackage?             @relation(fields: [shipmentPackageId], references: [id], onDelete: SetNull)
  shippoTransactionId           String
  shippoShipmentId              String?
  /// Chargeable purchased label cost (0 for failed_purchase).
  labelCostCents                Int
  /// Selected rate quote before purchase; not proof of Shippo billing.
  quotedLabelCostCents          Int?
  purpose                       ShipmentLabelFinancePurpose  @default(initial)
  replacesShippoTransactionId   String?
  status                        ShipmentLabelFinanceStatus   @default(active)
  sellerClawbackCents           Int                          @default(0)
  sellerClawbackReversalId      String?
  sellerCreditCents             Int                          @default(0)
  sellerCreditTransferId        String?
  clawbackIdempotencyKey        String?
  creditIdempotencyKey          String?
  /// Shared repair-level idempotency key when one Stripe transfer covers multiple failed labels.
  repairCreditIdempotencyKey    String?
  shippoStatus                  String?
  shippoObjectState             String?
  shippoMessagesJson            Json?
  clawbackFailedAt              DateTime?
  clawbackFailureDetail         String?
  creditFailedAt                DateTime?
  creditFailureDetail           String?
  /// Cumulative amount recovered via a SECONDARY mechanism (e.g. payout offset, admin manual
  /// recovery) after the primary immediate clawback (sellerClawbackCents) failed or fell short.
  /// Distinct from sellerClawbackCents so the primary-vs-secondary recovery path stays auditable.
  sellerRecoveredCents           Int                          @default(0)
  /// First moment this label had chargeable cost with no successful primary clawback covering it —
  /// i.e. when an "outstanding shipping liability" was first established. Never cleared/reset; a
  /// permanent audit marker even after the liability is later fully recovered or written off.
  liabilityEstablishedAt         DateTime?
  /// Admin-absorbed loss for this label (e.g. seller account closed, balance permanently
  /// unrecoverable). Reduces outstanding liability without claiming a real recovery occurred.
  writtenOffCents                Int                          @default(0)
  writtenOffAt                   DateTime?
  writtenOffReason               String?
  writtenOffByAdminId            String?
  liabilityRecoveries            ShipmentLabelLiabilityRecovery[]
  createdAt                     DateTime                     @default(now())
  updatedAt                     DateTime                     @updatedAt

  @@unique([orderId, shippoTransactionId])
  @@index([orderId])
  @@index([orderId, status])
  @@index([shippoTransactionId])
  @@index([replacesShippoTransactionId])
  @@index([sellerClawbackReversalId])
  @@index([sellerCreditTransferId])
  @@index([repairCreditIdempotencyKey])
  @@index([liabilityEstablishedAt])
}

enum ShipmentLabelLiabilityRecoveryMethod {
  /// Offset deducted from a Stripe Connect bank payout before it was sent.
  payout_offset_stripe
  /// Offset deducted from a PayPal seller payout before it was sent.
  payout_offset_paypal
  /// Admin-triggered manual retry of the original Connect transfer reversal.
  retry_clawback
  /// Admin manually recorded a recovery outside the automated mechanisms (rare).
  manual_admin
}

enum ShipmentLabelLiabilityRecoveryOutcome {
  recovered
  failed
  /// Attempted but a prior attempt with the same transactionId already recorded this recovery.
  skipped_idempotent
}

/// Append-only audit trail of every attempt to recover outstanding shipping liability for a label,
/// whether it succeeded, failed, or was a no-op idempotency skip. Never mutated after insert.
model ShipmentLabelLiabilityRecovery {
  id                      String                                @id @default(cuid())
  shipmentLabelFinanceId  String
  shipmentLabelFinance    ShipmentLabelFinance                  @relation(fields: [shipmentLabelFinanceId], references: [id], onDelete: Cascade)
  sellerId                String
  method                  ShipmentLabelLiabilityRecoveryMethod
  outcome                 ShipmentLabelLiabilityRecoveryOutcome
  amountCents             Int
  /// Stripe payout id / PayPal payout item id / admin action id this recovery rode on; used for
  /// idempotency (never apply the same transactionId twice against the same label).
  transactionId           String?
  detail                  String?
  createdAt               DateTime                              @default(now())

  @@index([shipmentLabelFinanceId])
  @@index([sellerId])
  @@index([transactionId])
  @@index([shipmentLabelFinanceId, transactionId])
}

/// Admin-editable marketplace platform fee (single-row config).
model PlatformMarketplaceFeeConfig {
  id                 String   @id @default("default")
  platformFeePercent Float    @default(6.75)
  updatedAt          DateTime @updatedAt
  updatedByUserId    String?
}

/// Admin-editable home-screen promo banner (mobile/web). Change copy anytime — no app rebuild.
model PlatformAppBanner {
  id              String    @id @default("default")
  enabled         Boolean   @default(false)
  title           String    @default("")
  body            String    @default("")
  /// Button label shown on the banner (e.g. "Get my link").
  ctaLabel        String    @default("")
  /// App/web path opened on tap (e.g. `/account/referrals`). Empty = non-tappable.
  href            String    @default("")
  /// Change this to re-show the banner after users dismissed a previous version.
  dismissKey      String    @default("default")
  startsAt        DateTime?
  endsAt          DateTime?
  updatedAt       DateTime  @updatedAt
  updatedByUserId String?
}

/// Admin-editable live show volume fee tiers (single-row config).
model PlatformLiveShowFeeConfig {
  id                String   @id @default("default")
  tier1FeePercent   Float    @default(6.75)
  tier2ThresholdUsd Float    @default(3000)
  tier2FeePercent   Float    @default(5.75)
  tier3ThresholdUsd Float    @default(5500)
  tier3FeePercent   Float    @default(5)
  updatedAt         DateTime @updatedAt
  updatedByUserId   String?
}

/// Admin-editable seller payout program thresholds and instant limits.
model PlatformPayoutProgramConfig {
  id                           String   @id @default("default")
  fastMinAccountAgeDays        Int      @default(30)
  fastMinLifetimeGmvUsd        Float    @default(10000)
  fastMinCompletedOrders       Int      @default(100)
  instantMinAccountAgeDays     Int      @default(60)
  instantMinLifetimeGmvUsd     Float    @default(5000)
  instantMaxCancellationRate   Float    @default(0.01)
  instantMaxChargebackRate     Float    @default(0.0075)
  instantMaxDisputeRate        Float    @default(0.0075)
  instantMaxUnresolvedDisputes Int      @default(0)
  instantPerOrderUsd           Float    @default(9999)
  instantDailyUsd              Float    @default(99990)
  instantMaxDailyCount         Int      @default(10)
  instantMaxOutstandingUsd     Float    @default(25000)
  instantSuspensionRateCeiling Float    @default(0.0075)
  updatedAt                    DateTime @updatedAt
  updatedByUserId              String?
}
