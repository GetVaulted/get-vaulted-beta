generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum BuyingFormat {
  buy_now
  auction
}

enum ListingStatus {
  draft
  active
  sold
  auction_live
  /// Auction time ended; winner must complete Stripe checkout before transfer.
  awaiting_auction_payment
  /// Winner did not pay within the payment window; listing is not sold.
  auction_ended_unpaid
  /// Reserved by an active marketplace layaway plan (deposit collected).
  layaway_reserved
  /// Seller-ended (or admin-approved early end); hidden from marketplace discovery.
  ended
}

enum ListingEndRequestStatus {
  pending
  approved
  denied
  canceled_by_seller
}

enum ListingEndReasonCategory {
  item_damaged
  listing_mistake
  inventory_unavailable
  suspected_fraud
  shipping_issue
  other
}

enum UserRole {
  user
  admin
}

/// Client platform reporting signed-in app presence heartbeats.
enum AppPresencePlatform {
  ios
  android
  web
}

enum LiveRoomType {
  auction
  sale
  break
}

enum LiveRoomStatus {
  scheduled
  live
  ended
}

/// Whether a show appears in buyer Live discovery (`public`) or link-only (`private`).
enum LiveRoomDiscoveryVisibility {
  public
  private
}

enum LiveStreamProvider {
  none
  aws_ivs
}

/// How a room's video is delivered. `stage_webrtc` = IVS Real-Time (sub-second WebRTC);
/// `channel_hls` = IVS Low-Latency/HLS channel (OBS path + overflow/replay fallback).
enum LiveStreamMode {
  stage_webrtc
  channel_hls
}

enum LiveStreamHealth {
  not_provisioned
  offline
  connecting
  live
  ended
  error
}

enum LiveRoomItemStatus {
  queued
  active
  sold
  skipped
}

enum LiveItemSalesFormat {
  auction
  buy_now
  variant_selection
  team_break
  /// Host-defined player list (Pick Your Player / Random Player).
  player_selection
}

/// PYT/PYD spot board default — hybrid lets host run fixed checkout or timed auction per pin.
enum LiveVariantSpotCommerceDefault {
  fixed
  auction
  hybrid
}

/// Runtime commerce mode for the host-pinned spot (fixed = hold to buy; auction = timed bids).
enum LiveActiveSpotCommerceMode {
  fixed
  auction
}

enum LiveItemVariantAssignmentMode {
  pick
  random
}

enum LiveItemVariantStatus {
  available
  reserved
  sold_out
  /// Host removed team from the board without a sale (not counted in Show sales).
  removed
}

enum LiveItemVariantPurchaseStatus {
  pending_payment
  paid
  failed
  cancelled
}

/// How the buyer paid the seller outside Get Vaulted (host-recorded).
enum OffPlatformSettlementMethod {
  venmo
  paypal
  cash_app
  cash
  zelle
  other
}

/// Required when an off-platform mark-sold is recorded at $0.
enum OffPlatformZeroReason {
  giveaway
  comp
  mistake
  other
}

/// Platform fee owed by the seller for an off-platform sale.
enum OffPlatformPlatformFeeStatus {
  unpaid
  paid
  waived
}

enum LiveRoomPaymentFailureStatus {
  payment_failed
  recovery_pending
  paid
}

enum LiveRoomPaymentFailureKind {
  auction_win
  buy_now
  break_spot
  variant_purchase
}

enum LiveRoomMessageType {
  chat
  bid
  purchase
  system
  tip
  /** Host/mod only — never returned or broadcast to buyers. */
  staff
}

enum TipRecipientMode {
  host
  moderator
}

enum LiveTipStatus {
  pending
  paid
  failed
}

enum BreakFormat {
  pick_your_team
  random_teams
  random_divisions
}

/// Host workflow for a break spot claim (distinct from queue item status).
enum BreakSpotClaimStatus {
  confirmed
  paid
  locked
  released
}

enum TeamBoardLeague {
  nfl
  nba
  mlb
  nhl
}

/// How marketplace order payment is collected.
enum OrderPaymentMethod {
  stripe
  escrow
  layaway
}

/// Primary payment processor for buyer charge (Stripe vs separate PayPal/Venmo path).
enum PaymentProcessor {
  STRIPE
  PAYPAL_VENMO
}

/// Wallet / checkout payment instrument type.
enum WalletPaymentMethodType {
  card
  apple_pay
  google_pay
  link
  cash_app_pay
  paypal
  venmo
}

/// How seller payout is routed for this order.
enum SellerPayoutProcessor {
  STRIPE
  PAYPAL
}

/// Marketplace layaway plan length (buyer-selected at checkout).
enum LayawayPlanType {
  thirty_day
  sixty_day
}

/// Marketplace layaway lifecycle.
enum LayawayStatus {
  active
  paid_off
  defaulted
  refunded
  completed
}

/// Layaway payment kind for audit and Stripe reconciliation.
enum LayawayPaymentKind {
  deposit
  installment
  balance_payoff
}

/// High-value escrow lifecycle (provider-agnostic names).
enum EscrowStatus {
  pending
  buyer_paid
  seller_shipped
  delivered
  inspection_period
  approved
  funds_released
  disputed
  cancelled
}

/// Short-lived reservation to prevent cross-channel oversell (live, checkout, offers).
enum LiveAuctionInventoryHoldStatus {
  active
  consumed
  released
  expired
}

enum InstantPayoutStatus {
  eligible
  ineligible
  suspended
  admin_override
}

enum PayoutRiskLevel {
  low
  medium
  high
}

enum OrderPayoutStatus {
  pending
  held
  delivery_confirmed
  fast_payout_ready
  label_payout_ready
  instant_payout_ready
  paid_out
  blocked
  manual_review
}

enum OrderPayoutMethod {
  standard
  fast_after_acceptance
  instant_after_label
  instant_after_delivery
}

enum OrderRefundRequestKind {
  cancel
  return
}

enum OrderRefundRequestStatus {
  pending_seller
  seller_denied
  escalated
  awaiting_return
  return_in_transit
  /// Stripe refund has been initiated (idempotency key durably recorded) but the DB has not yet
  /// confirmed the final `refunded` state — see `executeOrderRefund`. A row stuck here is not a
  /// money-mismatch (Stripe already has the idempotency key, so retrying is always safe); it means
  /// the local finalize write failed after Stripe succeeded, and the Stripe<->DB reconciliation
  /// cron (`reconcileStripeWithDatabase`) will self-heal it to `refunded` on its next pass.
  refund_processing
  support_denied
  refunded
}

enum SellerPayoutTier {
  standard
  fast
  instant
}

enum PayoutTierApprovalStatus {
  not_eligible
  eligible
  pending_approval
  approved
  denied
  suspended
}

/// Instant payout admin review workflow (separate from fast-tier approval).
enum InstantPayoutApprovalStatus {
  not_eligible
  eligible
  under_review
  approved
  suspended
}

enum AccountStanding {
  excellent
  good
  needs_attention
  restricted
}

/// Public-facing seller trust level (branding only — not payout mechanics).
enum SellerLevel {
  vault_seller
  trusted_seller
  vault_verified
  elite_vault_verified
}

enum SellerFraudStatus {
  none
  flagged
  investigation
}

enum ReportTargetType {
  user
  listing
  live_room
  message
  order
  break
}

enum ReportReason {
  harassment
  counterfeit
  scam_fraud
  spam
  inappropriate_content
  fake_bids
  seller_misconduct
  buyer_misconduct
  ip_violation
  other
}

enum ReportStatus {
  open
  reviewing
  resolved
  dismissed
}

enum SupportTicketCategory {
  order
  shipping
  payment
  trade
  live
  account
  bug
  report_user
  other
}

enum SupportTicketStatus {
  submitted
  in_progress
  resolved
  closed
}

enum MessageMentionSourceType {
  live_room_message
  thread_message
}

enum LiveRoomModeratorLevel {
  chat
  show
  break
  head
}

enum LiveRoomModerationActionType {
  mute
  unmute
  delete_message
  kick
  unkick
  room_ban
  unban
  block_bidding
  unblock_bidding
  slow_mode
  pin_message
  timeout
  seller_stream_ban
  seller_stream_unban
  post_announcement
  run_giveaway
}

enum LiveGiveawayKind {
  open
  buyers
}

enum LiveGiveawayStatus {
  draft
  entries_open
  entries_closed
  drawn
  cancelled
}

enum LiveGiveawayEntryMethod {
  watch_enter
  purchase
  amoe_form
}

enum DisputeEvidenceStatus {
  pending
  ready
  failed
}

/// IVS auto-recording lifecycle for a finished live show.
enum LiveStreamRecordingStatus {
  pending
  recording
  ready
  failed
  expired
}

/// Admin ZIP archive of an S3 HLS recording package.
enum LiveStreamArchiveStatus {
  none
  preparing
  ready
  failed
}

enum ShippingCategory {
  raw_card
  slab
  small_collectible
  custom
}

/// Which Shippo quotes buyers may choose at marketplace checkout.
enum MarketplaceShippingOfferScope {
  all
  no_overnight
  custom
}

enum AddressType {
  shipping
  return
  billing
  ship_from
}

enum TradeOfferStatus {
  pending
  countered
  accepted
  completed
  disputed
  declined
  cancelled
  expired
}

enum TradeItemSide {
  proposer
  recipient
}

enum TradeOfferEventType {
  offer_created
  offer_countered
  offer_accepted
  offer_declined
  offer_cancelled
  offer_expired
  platform_fee_paid
  cash_paid
  shipping_label_purchased
  shipping_label_failed
  party_shipped
  party_received
  offer_completed
  dispute_opened
  cash_released
  cash_refunded
  dispute_resolved
  deposit_paid
  deposit_refunded
}

model User {
  id                            String                      @id @default(cuid())
  email                         String                      @unique
  username                      String                      @unique
  passwordHash                  String?
  name                          String?
  image                         String?
  emailVerified                 DateTime?
  role                          UserRole                    @default(user)
  suspendedAt                   DateTime?
  /// Stripe Connect Express / Standard connected account id (`acct_...`).
  stripeAccountId               String?
  /// Seller preference: Stripe Connect (default) vs PayPal Payouts at release.
  preferredSellerPayoutProcessor SellerPayoutProcessor      @default(STRIPE)
  /// PayPal email that receives seller payouts when preference is PAYPAL.
  paypalPayoutEmail             String?
  /// Set when the PayPal payout email is confirmed / linked for payouts.
  paypalPayoutVerifiedAt        DateTime?
  /// Optional PayPal merchant / payer id after OAuth link.
  paypalMerchantId              String?
  /// True when Stripe reports charges enabled and payouts ready for selling.
  stripeOnboardingComplete      Boolean                     @default(false)
  /// Mirrors Stripe Account.charges_enabled (Connect).
  stripeChargesEnabled          Boolean?
  /// Mirrors Stripe Account.payouts_enabled (Connect).
  stripePayoutsEnabled          Boolean?
  /// Snapshot of requirement fields (currently_due, pending_verification, etc.) for dashboards + mobile.
  stripeRequirementsDue         Json?
  /// e.g. individual.verification.status from Stripe when present.
  stripeVerificationStatus      String?
  /// Stripe Customer id (`cus_...`) for buyer saved payment methods (auction / checkout).
  stripeCustomerId              String?
  /// PayPal vault customer id when buyer linked Venmo / PayPal wallet.
  paypalBuyerCustomerId         String?
  /// Vaulted Venmo payment token id (PayPal `/v3/vault/payment-tokens`).
  venmoPaymentTokenId           String?
  venmoUsername                 String?
  venmoVaultedAt                DateTime?
  /// Pending Venmo setup token while buyer completes PayPal/Venmo approval.
  venmoPendingSetupTokenId      String?
  venmoPendingSetupNonce        String?
  venmoPendingSetupMobile       Boolean                     @default(false)
  /// Vaulted PayPal Wallet payment token id (PayPal `/v3/vault/payment-tokens`).
  paypalWalletPaymentTokenId    String?
  paypalWalletEmail             String?
  paypalWalletVaultedAt         DateTime?
  /// Pending PayPal Wallet setup while buyer completes approval.
  paypalPendingSetupTokenId     String?
  paypalPendingSetupNonce       String?
  paypalPendingSetupMobile      Boolean                     @default(false)
  /// Preferred wallet instrument: Stripe `pm_…`, `venmo_<tokenId>`, or `paypal_<tokenId>`.
  buyerDefaultWalletPaymentMethodId String?
  /// Seller ship-from (origin) for Shippo label purchase.
  shipFromName                  String?
  shipFromStreet                String?
  shipFromCity                  String?
  shipFromState                 String?
  shipFromZip                   String?
  shipFromCountry               String?
  /// Set when seller finishes the onboarding wizard (step 5); syncs web + mobile activation.
  sellerSetupWizardCompletedAt  DateTime?
  /// Seller accepted marketplace seller agreement (Terms §5).
  sellerAgreementAcceptedAt     DateTime?
  /// Soft-delete — account anonymized; financial records retained.
  accountDeletedAt              DateTime?
  /// When the member last confirmed their public username (signup or profile setup). Used for the 60-day change lock.
  usernameChosenAt              DateTime?
  /// Referral attribution — set once at account creation from a `?ref=` signup link, never changed.
  referredById                  String?
  referredBy                    User?                       @relation("UserReferrals", fields: [referredById], references: [id], onDelete: SetNull)
  referrals                     User[]                      @relation("UserReferrals")
  referredAt                    DateTime?
  /// Unguessable share code for `/join?ref=...` (not the public username).
  referralCode                  String?                     @unique
  defaultShipFromAddressId      String?
  defaultShipFromAddress        Address?                    @relation("UserDefaultShipFromAddress", fields: [defaultShipFromAddressId], references: [id], onDelete: SetNull)
  /// Trustap external user id (`1-…`) when this user participates in escrow as seller (or linked buyer).
  trustapUserId                 String?
  /// Cached result of seller instant-payout eligibility checks (admin may override).
  instantPayoutEligible         Boolean                     @default(false)
  instantPayoutStatus           InstantPayoutStatus         @default(ineligible)
  instantPayoutOverrideByAdmin  Boolean                     @default(false)
  instantPayoutOverrideReason   String?
  instantPayoutOverrideAdminId  String?
  instantPayoutOverrideAt       DateTime?
  payoutRiskLevel               PayoutRiskLevel             @default(medium)
  /// Standard payout hold length (days) when instant payout is not available.
  payoutHoldDays                Int                         @default(7)
  /// Percent of order GMV held in reserve (0–100).
  payoutReservePercent          Float                       @default(0)
  /// Cached seller payout program tier (standard / fast / instant).
  payoutTier                    SellerPayoutTier            @default(standard)
  fastPayoutStatus              PayoutTierApprovalStatus    @default(not_eligible)
  fastPayoutOverrideByAdmin     Boolean                     @default(false)
  fastPayoutOverrideReason      String?
  fastPayoutOverrideAdminId     String?
  fastPayoutOverrideAt          DateTime?
  instantPayoutApprovalStatus   InstantPayoutApprovalStatus @default(not_eligible)
  instantPayoutReviewDate       DateTime?
  instantPayoutReviewedById     String?
  instantPayoutReviewNotes      String?
  instantPayoutRejectionReason  String?
  /// Public seller level badge (Vault Seller → Elite Vault Verified).
  sellerLevel                   SellerLevel                 @default(vault_seller)
  sellerLevelOverrideByAdmin    Boolean                     @default(false)
  sellerLevelOverrideAdminId    String?
  sellerLevelOverrideAt         DateTime?
  /// Per-seller instant payout limit overrides (USD); null = platform default.
  instantPayoutPerOrderLimitUsd Float?
  instantPayoutDailyLimitUsd    Float?
  instantPayoutExposureLimitUsd Float?
  /// Admin override for this seller's platform fee percent (marketplace + live). Null = platform default.
  sellerPlatformFeePercentOverride   Float?
  sellerPlatformFeeOverrideReason    String?
  sellerPlatformFeeOverrideAdminId   String?
  sellerPlatformFeeOverrideAt        DateTime?
  sellerPlatformFeeOverrideExpiresAt DateTime?
  payoutTierSuspensionReason    String?
  payoutTierSuspendedAt         DateTime?
  payoutMetrics                 SellerPayoutMetrics?
  createdAt                     DateTime                    @default(now())
  updatedAt                     DateTime                    @updatedAt

  listings                           Listing[]                   @relation("SellerListings")
  listingEndRequests                 ListingEndRequest[]         @relation("ListingEndRequestSeller")
  listingEndReviews                  ListingEndRequest[]         @relation("ListingEndRequestReviewer")
  bids                               Bid[]
  offers                             Offer[]                     @relation("OfferBuyer")
  sellerOffers                       Offer[]                     @relation("OfferSeller")
  orders                             Order[]                     @relation("OrderBuyer")
  sales                              Order[]                     @relation("OrderSeller")
  buyerRefundRequests                OrderRefundRequest[]        @relation("OrderRefundRequestBuyer")
  sellerRefundRequests               OrderRefundRequest[]        @relation("OrderRefundRequestSeller")
  watchlist                          WatchlistItem[]
  messagesSent                       Message[]                   @relation("MsgSender")
  messagesRecv                       Message[]                   @relation("MsgRecipient")
  threadsAsBuyer                     MessageThread[]             @relation("ThreadBuyer")
  threadsAsSeller                    MessageThread[]             @relation("ThreadSeller")
  messageThreadParticipants          MessageThreadParticipant[]
  userBlocksMade                     UserBlock[]                 @relation("UserBlockBlocker")
  userBlocksReceived                 UserBlock[]                 @relation("UserBlockBlocked")
  notifications                      Notification[]
  pushDeviceTokens                   PushDeviceToken[]
  liveRooms                          LiveRoom[]
  liveRoomMessages                   LiveRoomMessage[]
  breakSpots                         BreakSpot[]
  liveItemVariantPurchases           LiveItemVariantPurchase[]
  liveRoomPaymentFailures            LiveRoomPaymentFailure[]
  breakHitsBuyer                     BreakHit[]                  @relation("BreakHitBuyer")
  hitClipsAsSeller                   HitClip[]                   @relation("HitClipSeller")
  hitClipsAsBuyer                    HitClip[]                   @relation("HitClipBuyer")
  sellerFollowsAsFollower            SellerFollow[]              @relation("SellerFollowFollower")
  sellerFollowsAsSeller              SellerFollow[]              @relation("SellerFollowSeller")
  teamBoardPicks                     LiveRoomTeamBoardPick[]
  teamBoardAsPicker                  LiveRoomTeamBoard[]         @relation("LiveRoomTeamBoardPicker")
  sellerCommerceEvents               SellerCommerceEvent[]       @relation("SellerCommerceEvents")
  liveShippingSessionsAsBuyer        LiveShippingSession[]       @relation("LiveShippingSessionsBuyer")
  liveShippingSessionsAsSeller       LiveShippingSession[]       @relation("LiveShippingSessionsSeller")
  addresses                          Address[]                   @relation("UserAddresses")
  tradeOffersSent                    TradeOffer[]                @relation("TradeOfferProposer")
  tradeOffersReceived                TradeOffer[]                @relation("TradeOfferRecipient")
  tradeOfferItems                    TradeOfferItem[]            @relation("TradeOfferItemOwner")
  tradeOfferEvents                   TradeOfferEvent[]           @relation("TradeOfferEventActor")
  emailVerificationCodes             EmailVerificationCode[]
  liveAuctionProxyBids               LiveAuctionProxyBid[]
  liveAuctionInventoryHolds          LiveAuctionInventoryHold[]
  liveRoomBids                       LiveRoomBid[]
  liveRoomsAsTipModerator            LiveRoom[]                  @relation("LiveRoomTipModerator")
  liveTipsSent                       LiveTip[]                   @relation("LiveTipSender")
  liveTipsReceived                   LiveTip[]                   @relation("LiveTipRecipient")
  payoutEligibilityAuditLogsAsSeller PayoutEligibilityAuditLog[] @relation("PayoutAuditSeller")
  payoutEligibilityAuditLogsAsAdmin  PayoutEligibilityAuditLog[] @relation("PayoutAuditAdmin")
  reportsFiled                       Report[]                    @relation("ReportReporter")
  reportsAssigned                    Report[]                    @relation("ReportAssignee")
  supportTicketsSubmitted            SupportTicket[]             @relation("SupportTicketUser")
  supportTicketsAssigned             SupportTicket[]             @relation("SupportTicketAssignee")
  liveRoomModeratorAssignments       LiveRoomModerator[]         @relation("LiveRoomModeratorUser")
  liveRoomModeratorAssignedBy        LiveRoomModerator[]         @relation("LiveRoomModeratorAssignedBy")
  liveRoomModerationActionsTaken     LiveRoomModerationAction[]  @relation("LiveRoomModerationActor")
  liveRoomModerationActionsReceived  LiveRoomModerationAction[]  @relation("LiveRoomModerationTarget")
  liveRoomModerationActionsAsSeller  LiveRoomModerationAction[]  @relation("LiveRoomModerationSeller")
  sellerStreamBansFromSeller         SellerStreamBan[]           @relation("SellerStreamBanSeller")
  sellerStreamBansReceived           SellerStreamBan[]           @relation("SellerStreamBanTarget")
  sellerStreamBansIssued             SellerStreamBan[]           @relation("SellerStreamBanActor")
  reportAuditLogs                    ReportAuditLog[]
  trustModerationAuditLogs           TrustModerationAuditLog[]
  liveStreamReplaysAsSeller          LiveStreamReplay[]          @relation("LiveStreamReplaySeller")
  disputeEvidenceGenerated           DisputeEvidenceBundle[]     @relation("DisputeEvidenceAdmin")
  liveRoomMessagesDeleted            LiveRoomMessage[]           @relation("LiveRoomMessageDeletedBy")
  liveGiveawaysCreated               LiveGiveaway[]              @relation("LiveGiveawayCreator")
  liveGiveawaysWon                   LiveGiveaway[]              @relation("LiveGiveawayWinner")
  liveGiveawayEntries                LiveGiveawayEntry[]
  layawaysAsBuyer                    Layaway[]                   @relation("LayawayBuyer")
  layawaysAsSeller                   Layaway[]                   @relation("LayawaySeller")
  messageMentionsReceived            MessageMention[]            @relation("MessageMentionRecipient")
  messageMentionsAuthored            MessageMention[]            @relation("MessageMentionAuthor")
  sellerShippingProfiles             SellerShippingProfile[]
  notificationBroadcastsSent         NotificationBroadcast[]     @relation("NotificationBroadcastCreatedBy")
  referralCredits                    ReferralCredit[]            @relation("ReferralCreditOwner")
  platformCredits                    PlatformCredit[]            @relation("PlatformCreditOwner")
  giveawayEntryLedgers               GiveawayEntryLedger[]
  giveawayFraudFlags                 GiveawayFraudFlag[]
  giveawayCampaignsWon               GiveawayCampaign[]          @relation("GiveawayCampaignWinner")
  giveawayDrawsWon                   GiveawayDraw[]              @relation("GiveawayDrawWinner")
  giveawayDrawsAsAdmin               GiveawayDraw[]              @relation("GiveawayDrawAdmin")
  appPresence                        UserAppPresence[]
}

/// Signed-in foreground heartbeat for admin “online now” (one row per user + platform).
model UserAppPresence {
  id         String              @id @default(cuid())
  userId     String
  user       User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform   AppPresencePlatform
  lastSeenAt DateTime            @default(now())
  updatedAt  DateTime            @updatedAt

  @@unique([userId, platform])
  @@index([lastSeenAt])
  @@index([platform, lastSeenAt])
}

/// Single-use email verification OTP for signup (hashed at rest; expires).
model EmailVerificationCode {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  codeHash   String
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([userId, expiresAt])
  @@index([userId, consumedAt])
}

model Address {
  id         String      @id @default(cuid())
  userId     String
  user       User        @relation("UserAddresses", fields: [userId], references: [id], onDelete: Cascade)
  type       AddressType
  name       String
  fullName   String
  company    String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String      @default("US")
  phone      String?
  email      String?
  isDefault  Boolean     @default(false)
  isVerified Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  defaultForUsers User[]    @relation("UserDefaultShipFromAddress")
  listings        Listing[] @relation("ListingShipFromAddress")
  buyerOrders     Order[]   @relation("OrderBuyerAddress")
  sellerOrders    Order[]   @relation("OrderSellerShipFromAddress")

  @@index([userId, type, isDefault])
}

/// Seller-visible timeline (auction recovery, payment expiry, etc.).
model SellerCommerceEvent {
  id        String   @id @default(cuid())
  sellerId  String
  seller    User     @relation("SellerCommerceEvents", fields: [sellerId], references: [id], onDelete: Cascade)
  listingId String?
  orderId   String?
  kind      String
  title     String
  body      String
  createdAt DateTime @default(now())

  @@index([sellerId, createdAt])
  @@index([listingId])
}

model SellerFollow {
  id         String   @id @default(cuid())
  followerId String
  sellerId   String
  follower   User     @relation("SellerFollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  seller     User     @relation("SellerFollowSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([followerId, sellerId])
  @@index([sellerId])
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  href      String
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

model PushDeviceToken {
  id                 String   @id @default(cuid())
  userId             String
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expoPushToken      String
  platform           String?
  deviceName         String?
  supabaseAuthUserId String?
  updatedAt          DateTime @updatedAt

  @@unique([userId, expoPushToken])
  @@index([userId])
  @@index([supabaseAuthUserId])
}

/**
 * Log of admin-sent mass notifications ("push out a mass notification for events/deals").
 */
model NotificationBroadcast {
  id              String    @id @default(cuid())
  title           String
  body            String
  href            String?
  audience        String    @default("all")
  recipientCount  Int       @default(0)
  pushSentCount   Int       @default(0)
  createdByUserId String
  createdByUser   User      @relation("NotificationBroadcastCreatedBy", fields: [createdByUserId], references: [id], onDelete: Cascade)
  /// Client-generated idempotency key (one per compose+send attempt in the admin UI). The unique
  /// constraint is the actual concurrency guard: a reserved row is inserted *before* any
  /// notifications/pushes are sent, so a double-click or retried POST with the same key hits this
  /// constraint and safely replays the original result instead of fanning out duplicates.
  idempotencyKey  String?   @unique
  createdAt       DateTime  @default(now())
  /// Set once the fan-out (notification rows + push) actually finishes. Distinguishes a
  /// legitimate zero-recipient broadcast (`recipientCount: 0`, `completedAt` set) from a reserved
  /// placeholder row whose process crashed mid-send (`recipientCount: 0`, `completedAt` still
  /// null) — see `sendMassNotification`'s idempotency-conflict handling, which only treats a
  /// retry as a safe "replay" when this is set, and otherwise re-attempts the fan-out.
  completedAt     DateTime?

  @@index([createdAt])
}

model Listing {
  id                            String                        @id @default(cuid())
  sellerId                      String
  seller                        User                          @relation("SellerListings", fields: [sellerId], references: [id], onDelete: Cascade)
  title                         String
  description                   String                        @default("")
  category                      String
  condition                     String
  buyingFormat                  BuyingFormat
  priceUsd                      Float
  startingBidUsd                Float?
  currentBidUsd                 Float?
  allowOffers                   Boolean                       @default(false)
  /// Marketplace layaway (V1): seller opt-in for listings priced at $500+.
  allowLayaway                  Boolean                       @default(false)
  acceptTradeOffers             Boolean                       @default(false)
  minimumOfferUsd               Float?
  status                        ListingStatus                 @default(draft)
  shippingPriceUsd              Float                         @default(0)
  handlingTime                  String                        @default("")
  signatureRequired             Boolean                       @default(false)
  reservePriceUsd               Float?
  auctionDurationDays           Int?
  auctionEndsAt                 DateTime?
  viewsCount                    Int                           @default(0)
  watchersCount                 Int                           @default(0)
  vaultPick                     Boolean                       @default(false)
  /// Official company / merch listing — no marketplace platform fee on checkout (admin-only flag).
  isCompanyListing              Boolean                       @default(false)
  /// Hidden from marketplace when set (admin moderation)
  moderationRemovedAt           DateTime?
  adminReviewedAt               DateTime?
  /// Single autosave slot per seller (Create Listing draft)
  workspaceKey                  String?
  /// Parcel dimensions/weight for Shippo (imperial). Optional until seller fills for physical checkout.
  parcelWeightOz                Float?
  parcelLengthIn                Float?
  parcelWidthIn                 Float?
  parcelHeightIn                Float?
  /// Buyer-facing live shipping profile (separate from Shippo parcel/label weight).
  shippingCategory              ShippingCategory              @default(raw_card)
  shippingBaseWeightOz          Float                         @default(4)
  shippingIncrementalWeightOz   Float                         @default(1)
  shippingPriceCapCents         Int?
  shipAlone                     Boolean                       @default(false)
  shipFromAddressId             String?
  shipFromAddress               Address?                      @relation("ListingShipFromAddress", fields: [shipFromAddressId], references: [id], onDelete: SetNull)
  /// Seller rules for buyer-facing Shippo rate options at checkout.
  marketplaceShippingOfferScope MarketplaceShippingOfferScope @default(all)
  marketplaceAllowedRateKeys    String[]                      @default([])
  /// Canonical carrier keys (usps, ups, fedex, …) the seller offers at checkout.
  marketplaceAllowedCarriers    String[]                      @default([])
  /// Unified platform shipping profile (Live + Marketplace + Trade).
  platformShippingProfileId     String?
  platformShippingProfile       PlatformShippingProfile?      @relation(fields: [platformShippingProfileId], references: [id], onDelete: SetNull)
  createdAt                     DateTime                      @default(now())
  updatedAt                     DateTime                      @updatedAt

  images                   ListingImage[]
  offers                   Offer[]
  bids                     Bid[]
  orders                   Order[]
  watchlist                WatchlistItem[]
  messages                 Message[]
  messageThreads           MessageThread[]
  liveRoomItems            LiveRoomItem[]
  liveShippingSessionItems LiveShippingSessionItem[]
  incomingTradeOffers      TradeOffer[]               @relation("TradeOfferTargetListing")
  tradeOfferItems          TradeOfferItem[]           @relation("TradeOfferItemListing")
  inventoryHolds           LiveAuctionInventoryHold[]
  endRequests              ListingEndRequest[]
  endAuditLogs             ListingEndAuditLog[]
  layaway                  Layaway?

  @@unique([sellerId, workspaceKey])
  // Public marketplace browse/search filters by status+buyingFormat and orders by createdAt.
  @@index([status, buyingFormat, createdAt])
  // Seller "my listings" (Seller HQ) filters by sellerId and orders by updatedAt.
  @@index([sellerId, updatedAt])
  // Admin listings dashboard filters by status and orders by updatedAt.
  @@index([status, updatedAt])
  @@index([category])
}

model ListingEndRequest {
  id             String                   @id @default(cuid())
  listingId      String
  listing        Listing                  @relation(fields: [listingId], references: [id], onDelete: Cascade)
  sellerId       String
  seller         User                     @relation("ListingEndRequestSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  status         ListingEndRequestStatus  @default(pending)
  reasonCategory ListingEndReasonCategory
  reasonText     String
  adminNote      String?
  createdAt      DateTime                 @default(now())
  reviewedAt     DateTime?
  reviewedById   String?
  reviewedBy     User?                    @relation("ListingEndRequestReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  auditLogs      ListingEndAuditLog[]

  @@index([listingId, status, createdAt])
  @@index([sellerId, createdAt])
}

model ListingEndAuditLog {
  id                  String             @id @default(cuid())
  listingId           String
  listing             Listing            @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingEndRequestId String?
  listingEndRequest   ListingEndRequest? @relation(fields: [listingEndRequestId], references: [id], onDelete: SetNull)
  actorUserId         String?
  action              String
  detail              String             @default("")
  createdAt           DateTime           @default(now())

  @@index([listingId, createdAt])
}

model TradeOffer {
  id                 String           @id @default(cuid())
  targetListingId    String
  targetListing      Listing          @relation("TradeOfferTargetListing", fields: [targetListingId], references: [id], onDelete: Cascade)
  proposerId         String
  proposer           User             @relation("TradeOfferProposer", fields: [proposerId], references: [id], onDelete: Cascade)
  recipientId        String
  recipient          User             @relation("TradeOfferRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  status             TradeOfferStatus @default(pending)
  proposerCashUsd    Float            @default(0)
  recipientCashUsd   Float            @default(0)
  /// When the cash adder paid the on-platform trade cash Checkout (Stripe). Held by platform until release.
  cashPaidAt         DateTime?
  cashCheckoutSessionId String?
  cashPaymentIntentId   String?
  /// When held trade cash was transferred to the payee (after both confirm receipt or admin release).
  cashReleasedAt     DateTime?
  cashTransferId     String?
  /// When held trade cash was refunded to the payer (dispute / admin).
  cashRefundedAt     DateTime?
  cashRefundId       String?
  cashReleaseError   String?
  /// Participant opened a cash/fulfillment dispute — freezes completion and cash release.
  disputedAt         DateTime?
  disputeOpenedByUserId String?
  disputeReason      String?
  /// Refundable security deposit (straight / $0-cash trades). Platform-held until both confirm or admin refunds.
  proposerDepositPaidAt DateTime?
  recipientDepositPaidAt DateTime?
  proposerDepositCheckoutSessionId String?
  recipientDepositCheckoutSessionId String?
  proposerDepositPaymentIntentId String?
  recipientDepositPaymentIntentId String?
  proposerDepositRefundedAt DateTime?
  recipientDepositRefundedAt DateTime?
  proposerDepositRefundId String?
  recipientDepositRefundId String?
  /// Locked refundable deposit amount (cents) for both parties — set on first deposit checkout.
  securityDepositCents Int?
  messageToRecipient String?
  // Optional trade-linked conversation id (participant-scoped from the trade detail page).
  // Structured offer state + timeline remain authoritative for terms.
  conversationId     String?
  expiresAt          DateTime?
  /// When the proposer paid the $2.99 Get Vaulted platform fee.
  proposerPlatformFeePaidAt DateTime?
  /// When the recipient paid the $2.99 Get Vaulted platform fee.
  recipientPlatformFeePaidAt DateTime?
  proposerPlatformFeeCheckoutSessionId String?
  recipientPlatformFeeCheckoutSessionId String?
  /// Shipping portion charged (cents) in the combined platform-fee + label checkout.
  proposerShippingChargedCents Int?
  recipientShippingChargedCents Int?
  proposerShippoShipmentId String?
  recipientShippoShipmentId String?
  proposerShippoRateObjectId String?
  recipientShippoRateObjectId String?
  proposerShippoTransactionId String?
  recipientShippoTransactionId String?
  proposerLabelUrl String?
  recipientLabelUrl String?
  proposerTrackingNumber String?
  recipientTrackingNumber String?
  proposerTrackingUrl String?
  recipientTrackingUrl String?
  proposerLabelPurchasedAt DateTime?
  recipientLabelPurchasedAt DateTime?
  proposerLabelErrorMessage String?
  recipientLabelErrorMessage String?
  /// When this party marked their outbound package as shipped.
  proposerShippedAt DateTime?
  recipientShippedAt DateTime?
  /// When this party confirmed they received the counterparty's package.
  proposerReceivedAt DateTime?
  recipientReceivedAt DateTime?
  /// Optional parcel tier for outbound quotes (defaults to cards_slabs).
  shippingWeightTier String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  items  TradeOfferItem[]
  events TradeOfferEvent[]

  @@index([targetListingId, status, createdAt])
  @@index([proposerId, status, createdAt])
  @@index([recipientId, status, createdAt])
  @@index([status, updatedAt])
  @@index([conversationId])
  @@index([expiresAt])
}

model TradeOfferItem {
  id                       String        @id @default(cuid())
  tradeOfferId             String
  tradeOffer               TradeOffer    @relation(fields: [tradeOfferId], references: [id], onDelete: Cascade)
  side                     TradeItemSide
  ownerUserId              String
  ownerUser                User          @relation("TradeOfferItemOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  listingId                String
  listing                  Listing       @relation("TradeOfferItemListing", fields: [listingId], references: [id], onDelete: Restrict)
  quantity                 Int           @default(1)
  // Snapshot fields preserve offer integrity if source listing changes.
  listingTitleSnapshot     String
  listingImageUrlSnapshot  String?
  listingCategorySnapshot  String
  listingConditionSnapshot String
  listingPriceUsdSnapshot  Float
  createdAt                DateTime      @default(now())

  @@unique([tradeOfferId, side, listingId])
  @@index([tradeOfferId, side])
  @@index([ownerUserId, createdAt])
  @@index([listingId])
}

model TradeOfferEvent {
  id           String              @id @default(cuid())
  tradeOfferId String
  tradeOffer   TradeOffer          @relation(fields: [tradeOfferId], references: [id], onDelete: Cascade)
  type         TradeOfferEventType
  actorUserId  String?
  actorUser    User?               @relation("TradeOfferEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  note         String?
  createdAt    DateTime            @default(now())

  @@index([tradeOfferId, createdAt])
  @@index([actorUserId, createdAt])
}

model LiveRoom {
  id                      String                      @id @default(cuid())
  sellerId                String
  seller                  User                        @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  title                   String
  /// Public schedule / discovery blurb (not in-room show notes).
  description             String                      @default("")
  /// In-room show notes for people who enter the show (not discovery/share).
  showNotes               String                      @default("")
  /// Browse / filter bucket (matches live directory chips)
  category                String                      @default("Other")
  roomType                LiveRoomType
  status                  LiveRoomStatus              @default(scheduled)
  /// `public` = listed on Live Shows; `private` = reachable only via shared link.
  discoveryVisibility     LiveRoomDiscoveryVisibility @default(public)
  thumbnailUrl            String                      @default("")
  /// Short looping promo video (seller-uploaded) shown in scheduled rooms before go-live.
  teaserVideoUrl          String?
  /// Teaser length in milliseconds (validated on upload; max 15s).
  teaserVideoDurationMs   Int?
  viewerCount             Int                         @default(0)
  /// Last time `viewerCount` was written from live presence. Null / stale → discovery shows 0.
  viewerCountUpdatedAt    DateTime?
  streamProvider          LiveStreamProvider          @default(none)
  streamMode              LiveStreamMode              @default(stage_webrtc)
  streamHealth            LiveStreamHealth            @default(not_provisioned)
  ivsChannelArn           String?
  ivsChannelName          String?
  ivsPlaybackUrl          String?
  ivsIngestEndpoint       String?
  /// IVS Real-Time Stage ARN (WebRTC publish/subscribe). Null until a browser/mobile Go Live provisions it.
  ivsStageArn             String?
  /// Active stage->channel composition ARN (HLS mirror for fallback/overflow/replay). Null when not compositing.
  ivsCompositionArn       String?
  ivsStreamKeyArn         String?
  ivsStreamKeyCreatedAt   DateTime?
  streamStartedAt         DateTime?
  streamEndedAt           DateTime?
  lastIvsStatusSyncAt     DateTime?
  lastIvsError            String?
  /// When the host's WebRTC publisher was first detected absent while the room is still `live`.
  /// Cleared when a publisher returns; drives zombie-room auto-recovery. Null when host is present.
  hostAbsentSince         DateTime?
  /// Set when the T−15 host “get ready” notification was sent. Cleared if `scheduledStartAt` changes.
  hostPreStartNotifiedAt  DateTime?
  /// Set when the T−30 host reminder push was sent. Cleared if `scheduledStartAt` changes.
  hostT30NotifiedAt       DateTime?
  /// Set when the T−5 host reminder push was sent. Cleared if `scheduledStartAt` changes.
  hostT5NotifiedAt        DateTime?
  /// Set when the T-0 "time to go live" push was sent. Cleared if `scheduledStartAt` changes.
  hostGoLiveNotifiedAt    DateTime?
  /// Set when a scheduled show was auto-cancelled (status → `ended`) for never going live within
  /// an hour of `scheduledStartAt`. Distinguishes a no-show auto-cancel from a normal completed
  /// show or a seller/admin-initiated cancel, both of which also land on `ended`.
  autoCancelledAt         DateTime?
  /// SHA-256 hash of OBS browser-source widget token (plain token shown once on rotate).
  obsWidgetTokenHash      String?
  obsWidgetTokenRotatedAt DateTime?
  scheduledStartAt        DateTime?
  startedAt               DateTime?
  endedAt                 DateTime?
  /// Monotonic room-state version for realtime ordering/reconciliation.
  roomVersion             Int                         @default(0)
  /// Monotonic per-room auction event sequence (`LiveAuctionEvent.seq`); canonical ordering for fan-out.
  auctionEventSeq         Int                         @default(0)
  /// Cumulative completed item-sale GMV (USD) for this show session; resets when the show ends.
  completedSalesGmvUsd    Float                       @default(0)
  /// Final completed item-sale GMV (USD) snapshotted once when the show ends/cancels, before
  /// `completedSalesGmvUsd` resets to 0. Historical fee-tier reconstruction for past orders
  /// (seller sales report, admin finance/reconciliation) must read this instead of the
  /// live-progress field once the show is no longer `live` — see `seller-payout-estimate.ts`.
  finalSalesGmvUsd        Float?
  /// Who receives tips during this show (`moderator` requires `tipModeratorId`).
  tipRecipientMode        TipRecipientMode            @default(host)
  tipModeratorId          String?
  tipModerator            User?                       @relation("LiveRoomTipModerator", fields: [tipModeratorId], references: [id], onDelete: SetNull)
  createdAt               DateTime                    @default(now())
  updatedAt               DateTime                    @updatedAt

  /// Break host console — setup & randomization (break rooms only).
  breakFormat              BreakFormat     @default(pick_your_team)
  /// When set, shown in host console / feed; falls back to `title` if empty.
  breakDisplayTitle        String          @default("")
  breakSpotPriceUsd        Float?
  breakTotalSpots          Int?
  /// JSON string[] team / spot labels for random modes.
  breakTeamLabelsJson      String          @default("[]")
  breakFilledLockedAt      DateTime?
  assignmentsLockedAt      DateTime?
  randomizedAt             DateTime?
  randomizationSeed        String?
  randomizationPreviewJson String?
  randomizationResultJson  String?
  lockPurchases            Boolean         @default(false)
  breakPaused              Boolean         @default(false)
  /// Host paused the live video feed (room stays live; buyers see a hold screen).
  streamPaused             Boolean         @default(false)
  /// PYT team board organization (break rooms). Set at room creation.
  teamBoardLeague          TeamBoardLeague @default(nba)

  items                           LiveRoomItem[]
  messages                        LiveRoomMessage[]
  breakSpots                      BreakSpot[]
  variantPurchases                LiveItemVariantPurchase[]
  breakHits                       BreakHit[]
  hitClips                        HitClip[]
  teamBoard                       LiveRoomTeamBoard?
  shippingSessions                LiveShippingSession[]
  auctionEvents                   LiveAuctionEvent[]
  proxyBids                       LiveAuctionProxyBid[]
  roomBids                        LiveRoomBid[]
  tips                            LiveTip[]
  moderators                      LiveRoomModerator[]
  moderationActions               LiveRoomModerationAction[]
  giveaways                       LiveGiveaway[]
  sellerStreamBans                SellerStreamBan[]
  streamReplays                   LiveStreamReplay[]
  paymentFailures                 LiveRoomPaymentFailure[]
  reports                         Report[]
  slowModeSeconds                 Int                        @default(0)
  pinnedModeratorMessage          String?
  pinnedModeratorMessageAt        DateTime?
  pinnedModeratorMessageExpiresAt DateTime?
  pinnedModeratorUserId           String?

  /// Show-level shipping (unified profiles + cap/free shipping).
  defaultShippingProfileId       String?
  defaultShippingProfile         PlatformShippingProfile?  @relation(fields: [defaultShippingProfileId], references: [id], onDelete: SetNull)
  defaultSellerShippingProfileId String?
  defaultSellerShippingProfile   SellerShippingProfile?    @relation(fields: [defaultSellerShippingProfileId], references: [id], onDelete: SetNull)
  shippingMode                   LiveShowShippingMode      @default(capped)
  carrierPreference              LiveShowCarrierPreference @default(best_rate)
  bundleEligiblePurchases        Boolean                   @default(true)
  shippingTermsVersion           Int                       @default(1)
  shippingCapEnabled             Boolean                   @default(false)
  shippingCapCents               Int?
  freeShippingEnabled            Boolean                   @default(false)
  /// When true, seller absorbs shipping above buyer cap (default platform behavior).
  sellerPaysOverCap              Boolean                   @default(true)

  @@index([sellerId, status])
  @@index([status, scheduledStartAt])
  @@index([tipModeratorId])
}

/// Viewer tip during a live show — tracked separately from item/break sales (no platform fee, no GMV tier impact).
model LiveTip {
  id                      String        @id @default(cuid())
  liveRoomId              String
  liveRoom                LiveRoom      @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  senderId                String
  sender                  User          @relation("LiveTipSender", fields: [senderId], references: [id], onDelete: Cascade)
  recipientId             String
  recipient               User          @relation("LiveTipRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  amountUsd               Float
  message                 String        @default("")
  status                  LiveTipStatus @default(pending)
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paidAt                  DateTime?
  createdAt               DateTime      @default(now())
  updatedAt               DateTime      @updatedAt

  @@index([liveRoomId, createdAt])
  @@index([recipientId, createdAt])
  @@index([senderId, createdAt])
}

/// Durable canonical auction fan-out stream (per room). `seq` is monotonic per `liveRoomId`.
/// `publishedAt` null = pending flush to realtime gateways.
model LiveAuctionEvent {
  id          String    @id @default(cuid())
  liveRoomId  String
  liveRoom    LiveRoom  @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  seq         Int
  eventType   String
  itemId      String?
  payload     Json
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@unique([liveRoomId, seq])
  @@index([liveRoomId, publishedAt, seq])
}

/// Idempotent bid POST responses (`Idempotency-Key` header).
model LiveBidIdempotency {
  id         String   @id @default(cuid())
  userId     String
  liveRoomId String
  itemId     String
  key        String
  statusCode Int
  body       Json
  createdAt  DateTime @default(now())

  @@unique([userId, liveRoomId, itemId, key])
  @@index([createdAt])
}

/// Cross-channel inventory reservation (listing = single sellable unit in current schema).
/// Partial unique indexes (Postgres) enforce at most one `active` hold per `listingId` / host `liveRoomItemId` — see migration SQL.
model LiveAuctionInventoryHold {
  id             String                         @id @default(cuid())
  listingId      String?
  listing        Listing?                       @relation(fields: [listingId], references: [id], onDelete: Cascade)
  liveRoomItemId String?
  liveRoomItem   LiveRoomItem?                  @relation(fields: [liveRoomItemId], references: [id], onDelete: Cascade)
  userId         String
  user           User                           @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         LiveAuctionInventoryHoldStatus @default(active)
  /// e.g. `buy_now_checkout`, `auction_win_order`, `offer_accept`
  source         String
  units          Int                            @default(1)
  idempotencyKey String?
  expiresAt      DateTime
  consumedAt     DateTime?
  releasedAt     DateTime?
  orderId        String?
  order          Order?                         @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt      DateTime                       @default(now())
  updatedAt      DateTime                       @updatedAt

  @@index([listingId, status])
  @@index([liveRoomItemId, status])
  @@index([status, expiresAt])
  @@index([userId, listingId, status])
}

/// Buyer max (proxy) bid ceiling for live-room items without marketplace listing sync (host lots).
/// Listing-backed lots use marketplace `Bid` / `placeListingBid` only — proxy rows are ignored there.
model LiveAuctionProxyBid {
  id             String       @id @default(cuid())
  liveRoomId     String
  liveRoom       LiveRoom     @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  liveRoomItemId String
  liveRoomItem   LiveRoomItem @relation(fields: [liveRoomItemId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  maxAmountUsd   Float
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([liveRoomItemId, userId])
  @@index([liveRoomItemId])
}

/// On-stream PYT team selection board (break rooms). One row per room.
model LiveRoomTeamBoard {
  liveRoomId          String          @id
  liveRoom            LiveRoom        @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  league              TeamBoardLeague @default(nba)
  visible             Boolean         @default(false)
  locked              Boolean         @default(false)
  currentPickerUserId String?
  currentPicker       User?           @relation("LiveRoomTeamBoardPicker", fields: [currentPickerUserId], references: [id], onDelete: SetNull)
  updatedAt           DateTime        @updatedAt

  picks LiveRoomTeamBoardPick[]
}

model LiveRoomTeamBoardPick {
  id         String            @id @default(cuid())
  liveRoomId String
  league     TeamBoardLeague
  teamAbbr   String
  userId     String
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  pickedAt   DateTime          @default(now())
  board      LiveRoomTeamBoard @relation(fields: [liveRoomId], references: [liveRoomId], onDelete: Cascade)

  @@unique([liveRoomId, league, teamAbbr])
  @@index([liveRoomId, league])
}

model LiveRoomItem {
  id                          String                         @id @default(cuid())
  liveRoomId                  String
  liveRoom                    LiveRoom                       @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  listingId                   String?
  listing                     Listing?                       @relation(fields: [listingId], references: [id], onDelete: SetNull)
  /// When the item has no `listingId`, host-settled auctions still need a winner id (see live bid route).
  lastHighBidderId            String?
  title                       String
  /// Remaining units on this queue row (decrements as each numbered unit sells).
  quantity                    Int                            @default(1)
  /// Original unit count when the row was created (never decrements).
  quantityInitial             Int                            @default(1)
  imageUrl                    String                         @default("")
  priceUsd                    Float?
  startingBidUsd              Float?
  /// Minimum raise per bid when set; otherwise server default increment curve applies.
  bidIncrementUsd             Float?
  /// Optional reserve (hidden minimum to sell).
  reservePriceUsd             Float?
  currentBidUsd               Float?
  status                      LiveRoomItemStatus             @default(queued)
  sortOrder                   Int                            @default(0)
  /// NFL break: when true, MISC appears on the team board while this item is active.
  teamBoardMisc               Boolean                        @default(false)
  /// NFL PYT: when true, an NCAA buyable spot is included and NCAA appears on the team board.
  teamBoardNcaa               Boolean                        @default(false)
  /// Custom random-reveal pool labels (Pick Your Player random). JSON string array.
  customRandomPoolLabels      Json?
  /// Monotonic item-state version for realtime ordering/reconciliation.
  itemVersion                 Int                            @default(0)
  /// When the lot is `active`, host must set this true (via Start) before buyers can bid / claim for timed window.
  biddingOpen                 Boolean                        @default(false)
  /// When set and in the future, bidding is allowed until this instant (set together with `biddingOpen`).
  auctionEndsAt               DateTime?
  /// Clutch Time ON = no bid-time extension; OFF = bids refresh time-to-expiry to 10s.
  clutchTimeEnabled           Boolean                        @default(false)
  /// Commerce format for this queue row (variant / team break = selectable options).
  salesFormat                 LiveItemSalesFormat            @default(auction)
  /// pick = buyer chooses spot (PYT/PYD); random = wheel assigns team/division on purchase.
  variantAssignmentMode       LiveItemVariantAssignmentMode  @default(pick)
  /// All variant spots sold — host can begin the break (team_break / PYD).
  variantBreakReadyAt         DateTime?
  /// Host clicked Begin Break — broadcast to all viewers.
  variantBreakBeganAt         DateTime?
  /// PYT/PYD default spot commerce (`hybrid` = fixed or auction per pin when not live).
  variantSpotCommerceDefault  LiveVariantSpotCommerceDefault @default(hybrid)
  /// Active commerce mode for the currently pinned spot (`null` when no pin / idle).
  activeSpotCommerceMode      LiveActiveSpotCommerceMode?
  /// When set, timed bidding applies to this variant row only (must match pinned `isHot` variant).
  auctionVariantId            String?
  auctionVariant              LiveItemVariant?               @relation("LiveRoomItemAuctionVariant", fields: [auctionVariantId], references: [id], onDelete: SetNull)
  /// Platform shipping profile for this queue row (inherits show default on create).
  shippingProfileId           String?
  shippingProfile             PlatformShippingProfile?       @relation(fields: [shippingProfileId], references: [id], onDelete: SetNull)
  sellerShippingProfileId     String?
  sellerShippingProfile       SellerShippingProfile?         @relation(fields: [sellerShippingProfileId], references: [id], onDelete: SetNull)
  customWeightOz              Float?
  customLengthIn              Float?
  customWidthIn               Float?
  customHeightIn              Float?
  requiresSeparatePackage     Boolean?
  /// Frozen profile snapshot at sale time (JSON) — admin profile edits must not mutate sold rows.
  shippingProfileSnapshotJson String?
  createdAt                   DateTime                       @default(now())
  updatedAt                   DateTime                       @updatedAt
  breakHits                   BreakHit[]
  variants                    LiveItemVariant[]

  proxyBids      LiveAuctionProxyBid[]
  inventoryHolds LiveAuctionInventoryHold[]
  roomBids       LiveRoomBid[]

  @@index([liveRoomId, sortOrder])
}

/// Selectable option / spot on a master live queue item (PYT divisions, teams, custom).
model LiveItemVariant {
  id                String                    @id @default(cuid())
  liveRoomItemId    String
  liveRoomItem      LiveRoomItem              @relation(fields: [liveRoomItemId], references: [id], onDelete: Cascade)
  label             String
  priceUsd          Float
  quantityInitial   Int                       @default(1)
  quantityRemaining Int                       @default(1)
  soldCount         Int                       @default(0)
  isHot             Boolean                   @default(false)
  imageUrl          String                    @default("")
  color             String                    @default("")
  sortOrder         Int                       @default(0)
  status            LiveItemVariantStatus     @default(available)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  purchases         LiveItemVariantPurchase[]
  auctionForItems   LiveRoomItem[]            @relation("LiveRoomItemAuctionVariant")

  @@unique([liveRoomItemId, label])
  @@index([liveRoomItemId, sortOrder])
}

/// Per-buyer purchase of a variant option — one record per claim (never overwrite winners).
model LiveItemVariantPurchase {
  id                      String                        @id @default(cuid())
  liveRoomId              String
  liveRoom                LiveRoom                      @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  liveRoomItemId          String
  variantId               String
  variant                 LiveItemVariant               @relation(fields: [variantId], references: [id], onDelete: Cascade)
  buyerId                 String
  buyer                   User                          @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  quantity                Int                           @default(1)
  unitPriceUsd            Float
  totalUsd                Float
  paymentStatus           LiveItemVariantPurchaseStatus @default(pending_payment)
  idempotencyKey          String?                       @unique
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  paidAt                  DateTime?
  /// Wheel-assigned team/division label (random assignment mode).
  revealedLabel           String?
  revealedAbbr            String?
  /// Shared id when multiple spots are paid in one checkout (one Order / one PaymentIntent).
  batchId                 String?
  /// Shared across a batch; not unique so N purchases can point at one Order.
  fulfillmentOrderId      String?
  fulfillmentOrder        Order?                        @relation("VariantPurchaseFulfillmentOrder", fields: [fulfillmentOrderId], references: [id], onDelete: SetNull)
  /// Host-recorded sale settled outside Get Vaulted (Venmo / Cash App / etc.).
  settlementChannel       String?
  offPlatformMethod       OffPlatformSettlementMethod?
  offPlatformZeroReason   OffPlatformZeroReason?
  offPlatformNote         String?
  /// Platform fee the seller owes Get Vaulted for this off-platform sale (USD cents).
  platformFeeCents        Int?
  platformFeePercent      Float?
  platformFeeStatus       OffPlatformPlatformFeeStatus?
  platformFeePaidAt       DateTime?
  platformFeeCheckoutSessionId String?
  platformFeePaymentIntentId   String?
  createdAt               DateTime                      @default(now())

  /// Hard DB-level backstop against the random-reveal pool draw racing two concurrent purchases
  /// into the same label for the same item (Postgres treats multiple NULLs as distinct, so
  /// non-random / not-yet-revealed purchases are unaffected).
  @@unique([liveRoomItemId, revealedLabel])
  @@index([variantId, paymentStatus])
  @@index([liveRoomId, createdAt])
  @@index([buyerId, createdAt])
  @@index([batchId])
  @@index([fulfillmentOrderId])
  @@index([platformFeeStatus, createdAt])
}

/// Unresolved live-show payment failure — blocks buyer commerce in-room until paid or cleared.
model LiveRoomPaymentFailure {
  id                String                       @id @default(cuid())
  liveRoomId        String
  liveRoom          LiveRoom                     @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  buyerId           String
  buyer             User                         @relation(fields: [buyerId], references: [id], onDelete: Cascade)
  kind              LiveRoomPaymentFailureKind
  liveRoomItemId    String?
  orderId           String?
  variantPurchaseId String?
  breakSpotId       String?
  amountUsd         Float
  status            LiveRoomPaymentFailureStatus @default(payment_failed)
  failureReason     String?
  buyerUsername     String?
  itemTitle         String?
  failedAt          DateTime                     @default(now())
  recoveredAt       DateTime?
  updatedAt         DateTime                     @updatedAt

  @@index([liveRoomId, buyerId, status])
  @@index([liveRoomId, status])
  @@index([buyerId, status])
}

/// Accepted bid on a host lot (`listingId` null). Listing-backed lots use marketplace `Bid` rows.
model LiveRoomBid {
  id              String       @id @default(cuid())
  liveRoomId      String
  liveRoom        LiveRoom     @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  liveRoomItemId  String
  liveRoomItem    LiveRoomItem @relation(fields: [liveRoomItemId], references: [id], onDelete: Cascade)
  bidderId        String
  bidder          User         @relation(fields: [bidderId], references: [id], onDelete: Cascade)
  amountUsd       Float
  auctionEventSeq Int
  idempotencyKey  String?
  /// Postgres transaction `now()` when the bid was accepted.
  acceptedAt      DateTime
  createdAt       DateTime     @default(now())

  @@index([liveRoomItemId, acceptedAt])
  @@index([liveRoomId, acceptedAt])
  @@index([bidderId, acceptedAt])
}

/// PYT / break spot claims (placeholder commerce — no Order row).
model BreakSpot {
  id                      String               @id @default(cuid())
  liveRoomId              String
  liveRoom                LiveRoom             @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
  userId                  String
  user                    User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
