/// Shareable highlight from a break hit (metadata now; optional `clipUrl` for future video).
model HitClip {
  id              String    @id @default(cuid())
  liveRoomId      String
  liveRoom        LiveRoom  @relation(fields: [liveRoomId], references: [id], onDelete: Cascade)
