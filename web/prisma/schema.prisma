  /// Legacy string kept for migration; prefer `claimStatus`.
  status                  String               @default("confirmed")
  claimStatus             BreakSpotClaimStatus @default(confirmed)
  liveRoomItemId          String?
  paidAt                  DateTime?
  lockedAt                DateTime?
  /// Stripe Checkout for this spot (no Order row; digital claim).
  stripeCheckoutSessionId String?
  stripePaymentIntentId   String?
  breakPaymentStatus      String               @default("unpaid")
  fulfillmentOrderId      String?              @unique
  fulfillmentOrder        Order?               @relation("BreakSpotFulfillmentOrder", fields: [fulfillmentOrderId], references: [id], onDelete: SetNull)
  createdAt               DateTime             @default(now())

  @@unique([liveRoomId, spotLabel])
  @@index([liveRoomId])
  @@index([userId])
}

/// Logged hits for host console / future clip pipeline.
model BreakHit {
