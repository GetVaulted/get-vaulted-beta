{
  "name": "get-vaulted",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "prisma generate",
    "predev:localhost": "prisma generate",
    "dev": "next dev --hostname 0.0.0.0 --port 3000",
    "dev:localhost": "next dev",
    "lan": "node scripts/print-lan-ip.mjs",
    "dev:clean": "node scripts/clean-next-dev.mjs",
    "build": "prisma generate && next build",
    "netlify:build": "node scripts/prisma-migrate-deploy.mjs && npm run build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:generate:clean": "prisma generate && node scripts/clean-next-dev.mjs",
    "db:migrate:resolve:auction-deadline-applied": "prisma migrate resolve --applied 20260503200000_auction_payment_deadline",
    "db:seed": "prisma db seed",
    "db:purge-demo": "tsx scripts/purge-demo-seed-data.ts",
    "smoke:escrow": "tsx scripts/smoke-vaulted-secure-checkout.ts",
    "smoke:live": "node scripts/live-smoke-runner.mjs",
    "smoke:live:pw": "node scripts/live-smoke-playwright.mjs",
    "test:e2e:live": "playwright test tests/e2e/vaulted-live-reliability.spec.ts",
    "qa:seed-live-auction": "tsx scripts/seed-live-auction-qa.ts",
    "auction-fanout:drain": "tsx scripts/auction-fanout-drain.ts",
    "expire-inventory-holds": "tsx scripts/expire-live-auction-inventory-holds.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-ivs": "^3.1045.0",
    "@next-auth/prisma-adapter": "^1.0.7",
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "@stripe/connect-js": "^3.3.39",
    "@stripe/stripe-js": "^9.4.0",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.57.2",
    "@opentelemetry/resources": "^1.30.1",
    "@opentelemetry/sdk-node": "^0.57.2",
    "@opentelemetry/semantic-conventions": "^1.28.0",
    "@supabase/supabase-js": "^2.105.1",
    "bcryptjs": "^3.0.3",
    "hls.js": "^1.6.16",
    "next": "16.2.4",
    "next-auth": "^4.24.14",
    "kafkajs": "^2.2.4",
    "pg": "^8.20.0",
    "redis": "^4.7.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "stripe": "^18.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.4",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^3.2.4"
  }
}
