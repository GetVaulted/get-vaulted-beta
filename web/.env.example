# Copy to `.env` and fill in values. Required for production: see README.md.

# Prisma — PostgreSQL connection string (Supabase for local + Netlify beta/prod).
# Dashboard: Project Settings → Database → Connection string → URI (postgres:// or postgresql://).
# For serverless (Netlify), use Supabase’s pooled “Transaction” URI and append Prisma’s PgBouncer flags, e.g.:
#   ?pgbouncer=true&connection_limit=1
# Integration tests: set INTEGRATION_DATABASE_URL to a disposable Postgres DB (or reuse DATABASE_URL).
# Beta alignment: DATABASE_URL and mobile EXPO_PUBLIC_SUPABASE_URL must be the SAME Supabase project ref.
# See web/docs/beta-environment-alignment.md and: npx tsx scripts/verify-beta-env-alignment.ts
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
# Netlify migrations: optional when DATABASE_URL is the Supabase *pooler* URI. Use Session mode, port 5432,
# same password as DATABASE_URL. If unset or wrong, `npm run netlify:build` falls back to DATABASE_URL.
# DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres"
# Live rooms: colocate your API runtime (e.g. Vercel region), Supabase Realtime, and Postgres primary in the same
# region when possible — cross-region RTT stacks with every bid and broadcast.
# If you introduce read replicas, route GET /api/live-rooms/[id] (or Prisma) to the primary for that handler;
# replica lag is indistinguishable from stale room state during shows.
# --- Live marketplace gate ---
# Live buyer pages, host console, and `/api/live-rooms/*` are OFF until allowed (see `src/lib/live-coming-soon.ts`):
#   LIVE_MARKETPLACE_ENABLED=1   — turn on for local dev, production, or any host
# Beta Netlify (`beta.shopgetvaulted.com` via URL / NEXTAUTH_URL / …) is allowed automatically after deploy.
# Optional: LIVE_MARKETPLACE_BETA=1 or LIVE_MARKETPLACE_BETA_HOSTS=preview.shopgetvaulted.com
# Optional kill switch (forces live off everywhere): LIVE_MARKETPLACE_COMING_SOON=1
# Vitest runs (`NODE_ENV=test`) ignore ENABLED so tests keep working unless COMING_SOON is set.
# Optional: server logs for live room / host console loaders (404 branches, access). Set to `1` in `.env.local`.
# LIVE_CONSOLE_LOADER_DEBUG=1
# Optional: seller "Create room" — browser console `[create-live-room]` logs (must be NEXT_PUBLIC_* for client).
# NEXT_PUBLIC_CREATE_LIVE_ROOM_DEBUG=1
# Optional: server logs for POST /api/live-rooms (create path).
# LIVE_CREATE_DEBUG=1
# TEMPORARY — local dev only, exact value `1`. Stubs some APIs (no Postgres). Forced off in production. Remove when DATABASE_URL works.
# GV_DEV_TEMP_NO_DB=1
# TEMPORARY — local dev only, exact `1`. Skips Resend even if RESEND_API_KEY is set; APIs return `_localDevVerificationCode` (dev assist must stay on). Remove for real inbox tests.
# GV_DEV_SKIP_VERIFICATION_EMAIL=1
# INTEGRATION_DATABASE_URL="postgresql://..."
# Opt-in: `npx prisma db seed` inserts demo marketplace rows + demo live rooms only when true (never required for the app).
# ALLOW_DEMO_SEED="true"
# Opt-in: `npm run qa:seed-live-auction` / `tsx scripts/seed-live-auction-qa.ts` requires this to run (inserts QA users + listings).
# ALLOW_QA_LIVE_SEED="1"
# Opt-in: `npm run qa:seed-beta-accounts` — sellerqa@getvaultedtest.com + buyerqa@getvaultedtest.com (Auth + Prisma; project xkaaicokjgmpbctfermj only).
# QA gate: `npm run qa:local-env-check` (run before manual QA; see web/docs/qa-environment-reset.md)
# Optional on beta: GV_ALLOW_QA_SESSION_DEBUG=1 enables /api/qa/session-debug and /qa/diagnostics
# ALLOW_BETA_QA_SEED="1" also auto-provisions a Prisma User on GET /api/account/seller when session email has no row.
# Optional override: GV_AUTO_PROVISION_SELLER_USER="1"
# BETA_QA_ACCOUNT_PASSWORD="VaultedBetaQA1!"
# One-shot: delete seed fixture listings + demo live rooms + `*@getvaulted.internal` + `qa_live_*@test.internal` QA users (see `scripts/purge-demo-seed-data.ts`).
# CONFIRM_PURGE_DEMO="1"

# NextAuth — use a long random string in production (e.g. openssl rand -base64 32)
NEXTAUTH_SECRET="change-me-in-production"

# Public site URL (no trailing slash). Production: https://shopgetvaulted.com — Local: http://localhost:3000
NEXTAUTH_URL="http://localhost:3000"
# Production Netlify: set NEXTAUTH_URL and NEXT_PUBLIC_SITE_URL to https://shopgetvaulted.com
# NEXT_PUBLIC_SITE_URL="https://shopgetvaulted.com"
# --- Same Wi‑Fi (phone on your network) ---
# `npm run dev` listens on 0.0.0.0. Run `npm run lan` to print http://<PC_IP>:3000.
# While testing sign-in from the phone, set NEXTAUTH_URL to that LAN URL (same as the address in the browser).
# `next.config.ts` also auto-adds this machine's LAN IPv4s to Next.js `allowedDevOrigins` in dev (so iPhone/iPad
# still load after your router assigns a new IP). Set NEXT_DEV_DISABLE_AUTO_LAN_ORIGINS=1 to turn that off.
# When you switch Wi‑Fi networks, run `npm run lan` again: if your PC IP changed, update NEXTAUTH_URL and restart `npm run dev`.
# That hostname is also allowed for dev cross-origin; only use NEXT_DEV_ALLOWED_ORIGINS for extra hosts:
# NEXTAUTH_URL="http://192.168.1.50:3000"
# NEXT_DEV_ALLOWED_ORIGINS="10.0.0.12"
# Windows: allow Node.js (or port 3000 TCP inbound) in Defender Firewall when Windows asks.

# Resend — required for /api/auth/resend-verification in production; also used when signup is not Supabase-link.
# Primary web signup on the shared Supabase project uses Supabase Auth confirmation email instead.
# Production: verify shopgetvaulted.com in Resend and set RESEND_FROM to that domain (see docs/production-launch-config.md).
# `isApiDevVerificationAssistAllowed()` is true (see `src/lib/dev-verification-assist.ts`: never on production or
# Vercel production; set ALLOW_DEV_VERIFICATION_ASSIST=0 to disable locally).
RESEND_API_KEY=""
# From address Resend accepts (e.g. "Get Vaulted <onboarding@resend.dev>" for Resend trial).
RESEND_FROM=""
# After `npm run resend:sync-templates`, set to 1 to send via published Resend hosted templates.
# RESEND_USE_HOSTED_TEMPLATES=1

# Supabase — required in production (`next start`) for persistent listing image uploads.
# Use the Project URL and service_role key from Supabase Dashboard → Settings → API.
# Never expose the service role key to the client or prefix it with NEXT_PUBLIC_.
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-secret"
# Storage bucket for listing photos (create in Dashboard → Storage). Default if unset: listing-images
SUPABASE_STORAGE_BUCKET="listing-images"

# Supabase Realtime (browser) — anon key is safe to expose; used for live updates + optional postgres_changes.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# Social auth (Google + Apple on web): enable providers in Supabase Auth → Providers; allowlist redirect URLs in
# Supabase → URL Configuration (see web/docs/social-auth-setup.md and src/lib/supabase-oauth-redirect.ts).
# SUPABASE_ACCESS_TOKEN=sbp_... — Management API token for npm run configure:production-auth-urls (auth:write scope).
# NEXTAUTH_URL must match the browser origin users sign in from (local, beta, prod, Netlify preview).
# AUTH_OAUTH_APPLE_ENABLED=true — server-side flag (optional if NEXT_PUBLIC_* is set).
# NEXT_PUBLIC_AUTH_OAUTH_APPLE_ENABLED=true — required for "Continue with Apple" on sign-in / sign-up (browser bundle).
# AUTH_OAUTH_GOOGLE_ENABLED=false — optional kill switch for Google button only.
# Required for NextAuth Supabase credential sign-in (beta/mobile-created accounts). Or run: npm run setup:local-auth-env
# SUPABASE_ANON_KEY="your-anon-key"
# Only when the app database is Supabase Postgres with Realtime enabled on `LiveRoomMessage`, `BreakSpot`, `Bid`, `Notification`.
NEXT_PUBLIC_SUPABASE_ENABLE_POSTGRES_REALTIME="false"

# --- Stripe (Connect marketplace) — use Dashboard keys; live keys in production. Never commit secrets. ---
# Production Netlify context: sk_live_ + pk_live_ + live webhook secret. Beta can stay on test keys.
# Verify after deploy: npm run check:production-deployment
# Webhook forwarding: configure endpoint URL + signing secret in Stripe Dashboard for your deploy host.
STRIPE_SECRET_KEY="sk_..."
# Platform/payments destination (get-vaulted-production).
STRIPE_WEBHOOK_SECRET="whsec_..."
# Connect destination (get-vaulted-connect) — optional second signing secret, same /api/stripe/webhook URL.
# STRIPE_CONNECT_WEBHOOK_SECRET="whsec_..."
# Publishable key is safe in the browser; production builds should use pk_live_… from the live Dashboard.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_..."
# Platform fee on each charge (percent of item price only; Stripe processing and sales tax are separate).
STRIPE_PLATFORM_FEE_PERCENT="10"

# Optional Vault Wallet methods (enabled by default; set to "false" to hide).
# Also enable each method in Stripe Dashboard → Payment methods.
# STRIPE_WALLET_CASH_APP_ENABLED="true"
# STRIPE_WALLET_LINK_ENABLED="true"
# STRIPE_WALLET_AMAZON_PAY_ENABLED="true"
# Venmo buyer pay (PayPal vault — not Stripe). Shown only when configured.
# 1) PayPal Developer app: enable Save payment methods + Venmo
# 2) Set credentials (can reuse seller payout client id/secret)
# 3) PAYPAL_BUYER_VENMO_ENABLED=true
# WALLET_VENMO_ENABLED="true"
# PAYPAL_BUYER_VENMO_ENABLED="true"
# Optional HMAC secret for Venmo return URLs (defaults to PAYPAL_CLIENT_SECRET):
# PAYPAL_BUYER_VENMO_STATE_SECRET="..."
# $1 verification charge when linking Venmo (auto-refunded):
# PAYPAL_VENMO_VERIFY_AMOUNT_USD="1"

# --- PayPal seller payouts (optional rail; buyers still pay via Stripe unless Venmo) ---
# When enabled, sellers can choose PayPal instead of Stripe Connect. Charges are
# platform-held and paid out via PayPal Payouts API when payout gates fire.
# Venmo buyer charges also settle sellers on the PayPal payout rail.
# PAYPAL_SELLER_PAYOUTS_ENABLED="true"
# PAYPAL_CLIENT_ID="..."
# PAYPAL_CLIENT_SECRET="..."
# PAYPAL_MODE="sandbox"
# PAYPAL_WEBHOOK_ID="..."
# Local only — never enable in production:
# PAYPAL_WEBHOOK_ALLOW_UNSIGNED="true"

# Stripe Tax — buyer-paid sales tax via automatic_tax on Checkout (requires Stripe Tax enabled in Dashboard).
# Enabled by default when STRIPE_SECRET_KEY is set; nexus per state is controlled in Admin → Sales tax nexus.
# Set STRIPE_TAX_ENABLED=0 to disable collection entirely.
# STRIPE_TAX_ENABLED="1"

# Live replay retention (days) for dispute evidence — default 30
# REPLAY_RETENTION_DAYS="30"
# Connect `business_profile.url` must be a public URL (Stripe rejects localhost/LAN). When NEXTAUTH_URL is local,
# the app defaults to https://shopgetvaulted.com unless you set an explicit HTTPS base:
# STRIPE_CONNECT_BUSINESS_PROFILE_BASE_URL="https://shopgetvaulted.com"
# Mobile Account Link return/refresh URLs (must host /mobile/stripe-connect-return on Next.js):
# STRIPE_CONNECT_PUBLIC_APP_URL="https://shopgetvaulted.com"
# If unset, uses NEXT_PUBLIC_SITE_URL, then NEXTAUTH_URL, then the incoming request host.

# --- Optional high-value alternate checkout (off for MVP; Stripe Connect is default) ---
# When unset or not "true", the app is Stripe-only for marketplace checkout regardless of order size.
# Set to "true" only when you intentionally enable the alternate provider path and configure the vars below.
ESCROW_ENABLED="false"
# Provider id when re-enabled (currently: trustap). Omit or leave empty for Stripe-only.
ESCROW_PROVIDER="trustap"
# Required only when ESCROW_ENABLED=true and you use the Trustap-backed implementation:
TRUSTAP_API_KEY="your-trustap-api-key"
TRUSTAP_API_BASE_URL="https://api.trustap.com"
# Guest pay redirect base (provider actions host). Default derives from API URL when unset.
TRUSTAP_ACTIONS_BASE_URL="https://actions.trustap.com"
# Webhooks use HTTP Basic auth (username + password you configure in the provider dashboard).
TRUSTAP_WEBHOOK_USERNAME="vaulted-webhook-user"
TRUSTAP_WEBHOOK_PASSWORD="long-random-secret"
# IP recorded for guest buyer TOS acceptance (required for live guest user creation with Trustap).
TRUSTAP_GUEST_TOS_IP="203.0.113.1"
# Local / CI: skip HTTP and return a stub checkout URL (never enable in production with ESCROW_ENABLED=true).
TRUSTAP_USE_STUB_RESPONSE="0"
# Dev/test only: allow buyer fund release from `seller_shipped` without delivered/inspection (never in prod).
ESCROW_ALLOW_APPROVE_FROM_SELLER_SHIPPED="0"
# Estimated fee shown to buyers on the high-value path: basis points of subtotal (default 100 = 1%) with floor below.
ESCROW_FEE_BPS="100"
ESCROW_FEE_MIN_CENTS="2500"
# TODO: Auto-release after delivery if buyer is silent — implement job consumer reading this value.
ESCROW_AUTO_RELEASE_AFTER_DELIVERY_MS=""

# --- Shippo (labels & tracking) ---
# TODO: Production: restrict webhook IPs / verify signatures strictly.
SHIPPO_API_TOKEN="shippo_test_..."
# Shippo echoes ?token=... on webhook POST when appended to the webhook URL in Shippo dashboard.
# HMAC signing requires contacting Shippo support — URL token is the default self-serve option.
SHIPPO_WEBHOOK_SECRET="your-long-random-token"

# --- Live shipping pricing (buyer-facing during live auctions; separate from Shippo labels) ---
LIVE_SHIPPING_CAP_CENTS="1199"
# JSON array of tiers: [{ "maxWeightOz": 4, "costCents": 399 }, ...]
LIVE_SHIPPING_TIERS_JSON='[{"maxWeightOz":4,"costCents":399},{"maxWeightOz":8,"costCents":499},{"maxWeightOz":16,"costCents":599},{"maxWeightOz":32,"costCents":799},{"maxWeightOz":48,"costCents":999},{"maxWeightOz":1000000,"costCents":1199}]'
DEFAULT_RAW_CARD_BASE_WEIGHT_OZ="4"
DEFAULT_RAW_CARD_INCREMENTAL_WEIGHT_OZ="1"
DEFAULT_SLAB_BASE_WEIGHT_OZ="8"
DEFAULT_SLAB_INCREMENTAL_WEIGHT_OZ="3"
DEFAULT_SMALL_COLLECTIBLE_BASE_WEIGHT_OZ="6"
DEFAULT_SMALL_COLLECTIBLE_INCREMENTAL_WEIGHT_OZ="2"

# --- AWS IVS (OBS / RTMPS ingest for Vaulted Live) ---
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
# STANDARD | BASIC (STANDARD default)
AWS_IVS_CHANNEL_TYPE="STANDARD"
# LOW | NORMAL (LOW default)
AWS_IVS_LATENCY_MODE="LOW"
# Shared secret for POST /api/aws/ivs/events (EventBridge / internal forwarder). Use Authorization: Bearer <secret> or X-IVS-Events-Secret.
IVS_EVENTS_WEBHOOK_SECRET=""
# IVS auto-recording → private S3 (see web/infra/iam/LIVE_RECORDINGS.md). Leave unset to skip VOD.
# Align REPLAY_RETENTION_DAYS (above) with the bucket lifecycle (30 days).
# AWS_IVS_RECORDING_CONFIGURATION_ARN="arn:aws:ivs:us-east-1:758530011537:recording-configuration/xxxx"
# AWS_IVS_RECORDINGS_BUCKET="vaulted-live-recordings-beta"
# AWS_IVS_RECORDINGS_PREFIX="ivs/"
# Server IVS ops logs (JSON lines, no stream keys). Production: set true to enable; development: on unless set false.
IVS_OPS_LOG=""
# Client-only live debug logs + in-player IVS diagnostics overlay (never enable in public prod builds).
NEXT_PUBLIC_LIVE_DEBUG="false"

# --- OpenTelemetry (optional server traces) ---
# When set, `src/instrumentation.ts` exports OTLP/HTTP traces on Node boot. See `docs/live-auction-observability-load-chaos.md`.
# OTEL_EXPORTER_OTLP_ENDPOINT="https://your-collector:4318"
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT="https://your-collector:4318/v1/traces"
# OTEL_SERVICE_NAME="get-vaulted"

# --- Sentry (error monitoring) ---
# Complete no-op until these are set — safe to deploy without a Sentry account. See docs/production-error-monitoring.md.
# Server + edge runtime errors (route handlers, middleware, server components):
# SENTRY_DSN="https://xxxx@o0.ingest.sentry.io/0"
# Browser errors (must be NEXT_PUBLIC_* to reach the client bundle):
# NEXT_PUBLIC_SENTRY_DSN="https://xxxx@o0.ingest.sentry.io/0"
# Optional: overrides NODE_ENV as the Sentry "environment" tag (e.g. "beta", "production").
# SENTRY_ENVIRONMENT="production"
# NEXT_PUBLIC_SENTRY_ENVIRONMENT="production"
# Optional: enables source map upload during `next build` (readable stack traces in Sentry).
# Safe to leave unset — the build skips the upload step entirely (no warnings, no failure) if any
# of these three are missing. Generate the token in Sentry → Settings → Auth Tokens (scope:
# project:releases). Never commit the token; set it as a CI/Netlify build-only secret.
# SENTRY_ORG="your-org-slug"
# SENTRY_PROJECT="your-project-slug"
# SENTRY_AUTH_TOKEN="sntrys_..."
# `npm run auction-fanout:drain` batch size (1–200). Default 50.
# AUCTION_FANOUT_LIMIT="50"
# Optional canonical stream sidecars (dual-write from fan-out flush; Postgres remains SoT).
# REDIS_URL="rediss://:password@your-redis.redis.cache.windows.net:6380"
# KAFKA_BROKERS="broker1:9092,broker2:9092"
# KAFKA_TOPIC_AUCTION_EVENTS="auction.events"
# KAFKA_CLIENT_ID="get-vaulted-auction"
