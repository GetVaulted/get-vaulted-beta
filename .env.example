# === Expo / React Native (safe for client bundles) ===
EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
EXPO_PUBLIC_SITE_URL=https://shopgetvaulted.app

# === Netlify Functions & server-side only (never ship to Expo) ===
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# Server-side JWT verification (same key as Expo anon key — safe on Netlify only)
SUPABASE_ANON_KEY=your_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
STRIPE_SECRET_KEY=sk_live_or_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Shippo (labels)
SHIPPO_API_TOKEN=
SHIPPO_WEBHOOK_SECRET=

# AWS IVS (live)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_IVS_DEFAULT_LATENCY_MODE=LOW
AWS_IVS_DEFAULT_TYPE=STANDARD

# Magic Link: enable Email provider + "Confirm email" in Supabase Auth settings.
# Social login: add providers in Supabase Auth when ready.
