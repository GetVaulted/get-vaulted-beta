@@ -0,0 +1,49 @@
+import { describe, expect, it } from 'vitest';
+import {
+  AGORA_HOST_VIDEO,
+  agoraTokenRefreshDelayMs,
+  agoraZoomStops,
+  clampAgoraZoom,
+  friendlyAgoraError,
+  relayRetryDelayMs,
+} from './agoraHost';
+
+describe('agoraHost helpers', () => {
+  it('sends portrait video', () => {
+    expect(AGORA_HOST_VIDEO.height).toBeGreaterThan(AGORA_HOST_VIDEO.width);
+  });
+
+  it('offers zoom stops only the camera can reach', () => {
+    expect(agoraZoomStops(1, true)).toEqual([1]);
+    expect(agoraZoomStops(8, false)).toEqual([1]);
+    expect(agoraZoomStops(NaN, true)).toEqual([1]);
+    expect(agoraZoomStops(2.5, true)).toEqual([1, 2]);
+    expect(agoraZoomStops(10, true)).toEqual([1, 2, 3, 5]);
+  });
+
+  it('clamps zoom into the supported range', () => {
+    expect(clampAgoraZoom(0.5, 5)).toBe(1);
+    expect(clampAgoraZoom(9, 5)).toBe(5);
+    expect(clampAgoraZoom(2, 5)).toBe(2);
+    expect(clampAgoraZoom(NaN, 5)).toBe(1);
+    expect(clampAgoraZoom(3, NaN)).toBe(1);
+  });
+
+  it('backs off relay retries', () => {
+    expect(relayRetryDelayMs(1)).toBe(1_500);
+    expect(relayRetryDelayMs(3)).toBe(4_500);
+    expect(relayRetryDelayMs(0)).toBe(1_500);
+  });
+
+  it('refreshes the token an hour before it lapses, never in the past', () => {
+    expect(agoraTokenRefreshDelayMs(12 * 3600)).toBe(11 * 3600 * 1000);
+    expect(agoraTokenRefreshDelayMs(30 * 60)).toBe(60_000);
+    expect(agoraTokenRefreshDelayMs(0)).toBe(11 * 3600 * 1000);
+  });
+
+  it('turns permission failures into the camera message and keeps other messages', () => {
+    expect(friendlyAgoraError(new Error('Permission denied'))).toMatch(/Camera and microphone access/);
+    expect(friendlyAgoraError(new Error('Could not join live video (code -2).'))).toBe('Could not join live video (code -2).');
+    expect(friendlyAgoraError('')).toBe('Could not start the live broadcast.');
+  });
+});
diff --git a/mobile/src/lib/agoraHost.ts b/mobile/src/lib/agoraHost.ts
new file mode 100644
index 0000000..3439731
--- /dev/null
+++ b/mobile/src/lib/agoraHost.ts
@@ -0,0 +1,37 @@
+/** Pure helpers for the Agora host publisher (kept free of native imports so they unit-test). */
+
+/** Portrait 720p at 30 fps — the phone is always a portrait camera and Media Push forwards it as-is. */
+export const AGORA_HOST_VIDEO = { width: 720, height: 1280, frameRate: 30, bitrateKbps: 2500 } as const;
+
+/** Zoom steps the host UI offers: 1x plus whole-number stops the camera can actually reach. */
+export function agoraZoomStops(maxZoom: number, supported: boolean): number[] {
+  if (!supported || !Number.isFinite(maxZoom) || maxZoom < 2) return [1];
+  return [1, 2, 3, 5].filter((z) => z <= maxZoom);
+}
+
+export function clampAgoraZoom(factor: number, maxZoom: number): number {
+  if (!Number.isFinite(factor)) return 1;
+  const max = Number.isFinite(maxZoom) && maxZoom >= 1 ? maxZoom : 1;
+  return Math.min(Math.max(factor, 1), max);
+}
+
+/** Delay before the nth retry (1-based) of the relay start call: 1.5 s, 3 s, 4.5 s. */
+export function relayRetryDelayMs(attempt: number): number {
+  return 1_500 * Math.max(1, attempt);
+}
+
+/** Refresh the Agora token this long before it lapses (never sooner than a minute from now). */
+export function agoraTokenRefreshDelayMs(expiresInSeconds: number): number {
+  const leadMs = 60 * 60 * 1000;
+  if (expiresInSeconds > 0) return Math.max(60_000, expiresInSeconds * 1000 - leadMs);
+  return 11 * 60 * 60 * 1000;
+}
+
+export function friendlyAgoraError(err: unknown): string {
+  const msg = err instanceof Error ? err.message : String(err);
+  if (/permission|denied|not allowed/i.test(msg)) {
+    return 'Camera and microphone access is required to preview and go live. Enable both in Settings, then tap Retry.';
+  }
+  if (msg.trim()) return msg.trim();
+  return 'Could not start the live broadcast.';
+}
