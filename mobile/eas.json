{
  "cli": {
    "version": ">= 18.3.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SITE_URL": "https://beta.shopgetvaulted.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SITE_URL": "https://beta.shopgetvaulted.com"
      }
    },
    "production": {
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_SITE_URL": "https://beta.shopgetvaulted.com"
      }
    }
  },
  "submit": {
    "production": {},
    "preview": {
      "android": {
        "track": "internal"
      }
    }
  }
}
