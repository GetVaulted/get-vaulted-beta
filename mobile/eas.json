{
  "cli": {
    "version": ">= 18.3.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SITE_URL": "https://beta.shopgetvaulted.com",
        "EXPO_PUBLIC_AUTH_APPLE_ENABLED": "true"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SITE_URL": "https://beta.shopgetvaulted.com",
        "EXPO_PUBLIC_AUTH_APPLE_ENABLED": "true"
      }
    },
    "production": {
      "autoIncrement": false,
      "env": {
        "EXPO_PUBLIC_SITE_URL": "https://beta.shopgetvaulted.com",
        "EXPO_PUBLIC_SHARE_SITE_URL": "https://shopgetvaulted.com",
        "EXPO_PUBLIC_AUTH_APPLE_ENABLED": "true"
      }
    }
  },
  "submit": {
    "production": {
      "ios": {
        "appleId": "admin@shopgetvaulted.com",
        "appleTeamId": "6BJ9R4C598",
        "ascAppId": "6780714456"
      }
    },
    "preview": {
      "android": {
        "track": "internal"
      }
    }
  }
}
