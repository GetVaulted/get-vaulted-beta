EXPO_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your_anon_key
# Same origin as the Next.js app that exposes /api/stripe/connect/* (Bearer = Supabase access token).
# Must be reachable from the phone (not http://localhost on a physical device). Use your deployed https URL.
# Use the host where the Next.js Netlify site runs (e.g. beta.shopgetvaulted.com). The apex shopgetvaulted.com
# deploy is static-only — /api/* paths return Netlify 404 there.
# After changing EXPO_PUBLIC_* vars, restart Expo with cache clear so they are rebundled: npx expo start -c
EXPO_PUBLIC_SITE_URL=https://beta.shopgetvaulted.com
# Optional: override if API routes are on a different host than EXPO_PUBLIC_SITE_URL.
# EXPO_PUBLIC_WEB_API_URL=https://beta.shopgetvaulted.com

# Netlify Functions (Shippo rates, Stripe, username check) — include /.netlify/functions, no trailing slash
EXPO_PUBLIC_NETLIFY_FUNCTIONS_BASE=https://get-vaulted-beta.netlify.app/.netlify/functions
# Netlify also needs SHIPPO_API_TOKEN for live listing carrier quotes (shippo-listing-rates)

# Optional: username availability uses this function with the service role when the Supabase anon/Data API cannot read `public` (see netlify/functions/check-username-available.ts). Deploy Netlify with SUPABASE_URL + SUPABASE_SERVICE_ROLE_KEY.

# Dev only: attach placeholder Shippo ship-from addresses on new trade inserts so Stripe→Shippo webhook can succeed
EXPO_PUBLIC_TRADE_DEV_PLACEHOLDER_SHIP_FROM=0

# Dev / QA: show Trade Center QA tools in HQ + Trade Center (must set EXPO_PUBLIC_ENABLE_DEV_TOOLS=1 or true — not tied to __DEV__)
EXPO_PUBLIC_ENABLE_DEV_TOOLS=0

# QA incoming demo trade: second Supabase auth user UUID (must own a live listing offered to you)
EXPO_PUBLIC_TRADE_DEMO_PARTNER_USER_ID=

# Optional: partner placeholder listing uses RPC qa_seed_partner_trade_listing (see Supabase migrations)

# Do NOT put SUPABASE_SERVICE_ROLE_KEY or STRIPE_SECRET_KEY in the mobile app.
