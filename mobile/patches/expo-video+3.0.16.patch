--- a/node_modules/expo-video/android/src/main/java/expo/modules/video/VideoView.kt
+++ b/node_modules/expo-video/android/src/main/java/expo/modules/video/VideoView.kt
@@ -261,6 +261,15 @@ open class VideoView(context: Context, appContext: AppContext, useTextureView: B
    * hides all children of the root view and makes the player the only visible child of the rootView.
    */
   fun layoutForPiPEnter() {
+    // GET-VAULTED-MOBILE-F: PictureInPictureHelperFragment forwards the Activity's
+    // onPictureInPictureModeChanged straight into this call with no de-duplication, and a
+    // fragment left attached after this VideoView has been recycled/reparented by the
+    // live-feed pager (see the pager-view race this same audit flagged separately) can deliver
+    // it more than once, or after we're already laid out for PiP. Re-running the body would
+    // walk rootView's children again and append a second, stale batch of visibility entries on
+    // top of the ones already recorded - corrupting layoutForPiPExit()'s restore - so make entry
+    // idempotent instead of assuming exactly one call per transition.
+    if (playerView.parent === rootView) return
     playerView.useController = false
     (playerView.parent as? ViewGroup)?.removeView(playerView)
     for (i in 0 until rootView.childCount) {
@@ -274,11 +283,34 @@ open class VideoView(context: Context, appContext: AppContext, useTextureView: B
 
   fun layoutForPiPExit() {
     playerView.useController = useNativeControls
-    rootView.removeView(playerView)
+    // Detach playerView from whatever parent it actually has right now, not just rootView
+    // specifically. A duplicate/overlapping enter call, or this VideoView being recycled by
+    // the live-feed pager mid-transition, can leave playerView parented somewhere other than
+    // rootView by the time exit runs; rootView.removeView() on a view it doesn't actually own
+    // is a silent no-op, so the addView() below then throws "The specified child already has
+    // a parent" (GET-VAULTED-MOBILE-F) because playerView was never actually detached. Mirror
+    // layoutForPiPEnter()'s own defensive detach instead of assuming rootView is the parent.
+    (playerView.parent as? ViewGroup)?.removeView(playerView)
+    // rootView's children can change while PiP is active (navigation, overlays, etc. can add or
+    // remove views elsewhere in the same root while this video is pinned in PiP) - the recorded
+    // list only covers the children present at layoutForPiPEnter() time. Bounds-check the index
+    // instead of assuming child count is unchanged, so an added child doesn't crash with
+    // IndexOutOfBoundsException; skip restoring visibility for indices we didn't record.
+    //
+    // Snapshot into a local, private copy (and clear the shared field immediately) instead of
+    // reading rootViewChildrenOriginalVisibility.size and then indexing the shared field across
+    // the whole loop: a fast PiP re-entry on the same view (rapid swipe through a live feed can
+    // recycle this VideoView and call layoutForPiPEnter()/layoutForPiPExit() again before this
+    // exit finishes) mutates that shared field mid-loop, which is exactly how "index N out of
+    // bounds for length N" showed up in production even with the count check above - the guard
+    // was reading a list whose size had already changed since recordedCount was captured.
+    val recordedVisibility = ArrayList(rootViewChildrenOriginalVisibility)
+    rootViewChildrenOriginalVisibility.clear()
     for (i in 0 until rootView.childCount) {
-      rootView.getChildAt(i).visibility = rootViewChildrenOriginalVisibility[i]
+      if (i < recordedVisibility.size) {
+        rootView.getChildAt(i).visibility = recordedVisibility[i]
+      }
     }
-    rootViewChildrenOriginalVisibility.clear()
     this.addView(playerView)
   }
 
