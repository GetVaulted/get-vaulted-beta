{
  "expo": {
    "name": "Get Vaulted",
    "slug": "get-vaulted",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Get Vaulted uses your photo library for profile photos and listing images.",
        "NSCameraUsageDescription": "Get Vaulted uses the camera for profile photos and listing images."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#050505"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Get Vaulted uses your photos for profile and listing uploads.",
          "cameraPermission": "Get Vaulted uses your camera to take listing and profile photos."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#d4af37"
        }
      ],
      "expo-web-browser"
    ]
  }
}
