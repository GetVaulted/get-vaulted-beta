{
  "expo": {
    "name": "Get Vaulted",
    "slug": "get-vaulted",
    "version": "1.0.0",
    "scheme": "getvaulted",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#050505"
    },
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.getvaulted.app",
      "buildNumber": "66",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Get Vaulted uses your photo library for profile photos and listing images.",
        "NSCameraUsageDescription": "Get Vaulted uses the camera for live broadcasts, profile photos, and listing images.",
        "NSMicrophoneUsageDescription": "Get Vaulted uses the microphone for live broadcasts.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.getvaulted.app",
      "versionCode": 66,
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#050505"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Get Vaulted uses your photos for profile and listing uploads.",
          "cameraPermission": "Get Vaulted uses your camera to take listing and profile photos."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#d4af37",
          "defaultChannel": "vault-default"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-video",
        {
          "supportsPictureInPicture": true,
          "supportsBackgroundPlayback": true
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.getvaulted.app",
          "enableGooglePay": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6119563c-2c33-4ada-b3f4-8c42b8e2be7c"
      }
    }
  }
}
