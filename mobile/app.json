{
  "expo": {
    "name": "Get Vaulted",
    "slug": "get-vaulted",
    "version": "1.0.8",
    "scheme": "getvaulted",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/icon.png",
      "resizeMode": "cover",
      "backgroundColor": "#000000"
    },
    "ios": {
      "supportsTablet": true,
      "usesAppleSignIn": true,
      "bundleIdentifier": "com.getvaulted.app",
      "version": "1.0.8",
      "buildNumber": "223",
      "appStoreUrl": "https://apps.apple.com/app/id6780714456",
      "associatedDomains": [
        "applinks:shopgetvaulted.com",
        "applinks:www.shopgetvaulted.com",
        "applinks:beta.shopgetvaulted.com"
      ],
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Get Vaulted uses your photo library for profile photos and listing images.",
        "NSCameraUsageDescription": "Get Vaulted uses the camera for live broadcasts, profile photos, and listing images.",
        "NSMicrophoneUsageDescription": "Get Vaulted uses the microphone for live broadcasts.",
        "ITSAppUsesNonExemptEncryption": false,
        "UIBackgroundModes": [
          "audio"
        ]
      }
    },
    "android": {
      "package": "com.getvaulted.app",
      "version": "1.0.8",
      "versionCode": 223,
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.getvaulted.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon.png",
        "backgroundColor": "#050505"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ],
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ],
          "data": [
            {
              "scheme": "https",
              "host": "shopgetvaulted.com",
              "pathPrefix": "/live"
            },
            {
              "scheme": "https",
              "host": "www.shopgetvaulted.com",
              "pathPrefix": "/live"
            },
            {
              "scheme": "https",
              "host": "shopgetvaulted.com",
              "pathPrefix": "/listing"
            },
            {
              "scheme": "https",
              "host": "www.shopgetvaulted.com",
              "pathPrefix": "/listing"
            },
            {
              "scheme": "https",
              "host": "shopgetvaulted.com",
              "pathPrefix": "/marketplace"
            },
            {
              "scheme": "https",
              "host": "www.shopgetvaulted.com",
              "pathPrefix": "/marketplace"
            },
            {
              "scheme": "https",
              "host": "shopgetvaulted.com",
              "pathPrefix": "/join"
            },
            {
              "scheme": "https",
              "host": "www.shopgetvaulted.com",
              "pathPrefix": "/join"
            }
          ]
        }
      ]
    },
    "web": {
      "favicon": "./assets/icon.png"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Get Vaulted uses your photos for profile and listing uploads.",
          "cameraPermission": "Get Vaulted uses your camera to take listing and profile photos."
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Get Vaulted saves Hit Clips to your camera roll so you can post them to TikTok.",
          "savePhotosPermission": "Get Vaulted saves Hit Clips to your camera roll so you can post them to TikTok.",
          "isAccessMediaLocationEnabled": false
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#d4af37",
          "defaultChannel": "vault-default"
        }
      ],
      "expo-web-browser",
      "expo-apple-authentication",
      [
        "expo-video",
        {
          "supportsPictureInPicture": true,
          "supportsBackgroundPlayback": true
        }
      ],
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.getvaulted.app",
          "enableGooglePay": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "6119563c-2c33-4ada-b3f4-8c42b8e2be7c"
      }
    }
  }
}
